# EditorConfig specification: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi,rs}]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,jsonl,html,jinja,css,sh,svg,xml}]
indent_style = space
indent_size = 2

[tests/unit/api_surface.json]
indent_style = space
indent_size = 1

[*.{md,rst}]
indent_style = space
max_line_length = off

[{Makefile,*.mk}]
indent_style = tab
tab_width = 4
