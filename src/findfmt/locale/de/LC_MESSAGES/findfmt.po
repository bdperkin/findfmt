#: src/findfmt/cli/entrypoints.py:237
msgid ""
"Find all files and directories, including hidden files respecting "
".gitignore."
msgstr ""
"Alle Dateien und Verzeichnisse finden, einschließlich versteckter Dateien"
" unter Berücksichtigung von .gitignore."

#: src/findfmt/cli/entrypoints.py:256
msgid ""
"Find files and list detected format and MIME tags, including hidden files"
" respecting .gitignore."
msgstr ""
"Dateien finden und erkannte Format- sowie MIME-Tags auflisten, "
"einschließlich versteckter Dateien unter Berücksichtigung von .gitignore."

#: src/findfmt/cli/entrypoints.py:285
msgid ""
"Find files by format tag, including hidden files respecting .gitignore.\n"
"\n"
"Optionally provide TAG as the first positional argument (e.g. "
"'findfilefmt python')."
msgstr ""
"Dateien nach Format-Tag finden, einschließlich versteckter Dateien unter "
"Berücksichtigung von .gitignore.\n"
"\n"
"Optional TAG als erstes Positionsargument angeben (z. B. 'findfilefmt "
"python')."

#: src/findfmt/cli/entrypoints.py:314
msgid ""
"Find files by shebang interpreter pattern, including hidden files "
"respecting .gitignore.\n"
"\n"
"Optionally provide INTERPRETER as the first positional argument (e.g. "
"'findshebang bash')."
msgstr ""
"Dateien nach Shebang-Interpretermuster finden, einschließlich versteckter"
" Dateien unter Berücksichtigung von .gitignore.\n"
"\n"
"Optional INTERPRETER als erstes Positionsargument angeben (z. B. "
"'findshebang bash')."

#: src/findfmt/cli/entrypoints.py:336
msgid ""
"Find files and output NUL-delimited paths (--print0), including hidden "
"files respecting .gitignore."
msgstr ""
"Dateien finden und NUL-getrennte Pfade ausgeben (--print0), "
"einschließlich versteckter Dateien unter Berücksichtigung von .gitignore."

#: src/findfmt/cli/entrypoints.py:356
msgid ""
"Find files and print summary statistics to stderr, including hidden files"
" respecting .gitignore."
msgstr ""
"Dateien finden und Zusammenfassungsstatistiken auf stderr ausgeben, "
"einschließlich versteckter Dateien unter Berücksichtigung von .gitignore."

#: src/findfmt/cli/file_config.py:185
#, python-brace-format
msgid "Error: Configuration file '{path}' not found."
msgstr "Fehler: Konfigurationsdatei '{path}' nicht gefunden."

#: src/findfmt/cli/file_config.py:197
#, python-brace-format
msgid "Error: Invalid TOML in configuration file '{path}': {error}"
msgstr "Fehler: Ungültiges TOML in Konfigurationsdatei '{path}': {error}"

#: src/findfmt/cli/file_config.py:206
#, python-brace-format
msgid "Error reading configuration file '{path}': {error}"
msgstr "Fehler beim Lesen der Konfigurationsdatei '{path}': {error}"

#: src/findfmt/cli/file_config.py:285
msgid "(none)"
msgstr "(keine)"

#: src/findfmt/cli/file_config.py:286
#, python-brace-format
msgid "Active configuration: {path} (using built-in defaults)\n"
msgstr ""
"Aktive Konfiguration: {path} (integrierte Standardwerte werden verwendet)"
"\n"

#: src/findfmt/cli/file_config.py:290
#, python-brace-format
msgid "Active configuration: {path}"
msgstr "Aktive Konfiguration: {path}"

#: src/findfmt/cli/help.py:93
msgid ""
"A .gitignore-aware file discovery and classification suite that locates "
"files by content format, shebang, and MIME tag."
msgstr ""
"Ein .gitignore-bewusstes Dateierkennungs- und Klassifizierungswerkzeug, "
"das Dateien nach Inhaltsformat, Shebang und MIME-Tag findet."

#: src/findfmt/cli/help.py:98
msgid ""
"Common Examples:\n"
"  findfmt -t python                        # Find Python files\n"
"  findfmt --shebang bash scripts/          # Find bash scripts in "
"scripts/\n"
"  findfmt -t python -t executable --all-tags # Files matching both tags\n"
"  findfiles --no-hidden                    # Wrapper: exclude hidden "
"files\n"
"  findfmt -- -weird-name                   # Path starting with a dash\n"
"\n"
"Run 'findfmt --help-all' for the comprehensive manual, environment "
"variables, and exit codes."
msgstr ""
"Häufige Beispiele:\n"
"  findfmt -t python                        # Python-Dateien finden\n"
"  findfmt --shebang bash scripts/          # Bash-Skripte in scripts/ "
"finden\n"
"  findfmt -t python -t executable --all-tags # Dateien mit beiden Tags\n"
"  findfiles --no-hidden                    # Wrapper: versteckte Dateien "
"ausschließen\n"
"  findfmt -- -weird-name                   # Pfad mit führendem "
"Bindestrich\n"
"\n"
"Führen Sie 'findfmt --help-all' für das vollständige Handbuch, "
"Umgebungsvariablen und Exit-Codes aus."

#: src/findfmt/cli/help.py:109
msgid ""
"One or more directory or file paths to inspect (default: current "
"directory)."
msgstr ""
"Ein oder mehrere zu untersuchende Verzeichnis- oder Dateipfade (Standard:"
" aktuelles Verzeichnis)."

#: src/findfmt/cli/help.py:110
msgid ""
"Tag or comma-separated tags to match (e.g. 'python', 'yaml,json', "
"'executable')."
msgstr ""
"Abzugleichendes Tag oder kommagetrennte Tags (z. B. 'python', "
"'yaml,json', 'executable')."

#: src/findfmt/cli/help.py:111
msgid "Tag or comma-separated tags to exclude."
msgstr "Auszuschließendes Tag oder kommagetrennte Tags."

#: src/findfmt/cli/help.py:112
msgid "Require matching files to have ALL specified tags rather than ANY tag."
msgstr ""
"Verlangen, dass passende Dateien ALLE angegebenen Tags statt nur "
"MINDESTENS EINES aufweisen."

#: src/findfmt/cli/help.py:113
msgid "Filter files whose shebang contains this interpreter or pattern."
msgstr ""
"Dateien filtern, deren Shebang diesen Interpreter oder dieses Muster "
"enthält."

#: src/findfmt/cli/help.py:114
msgid "Do not respect .gitignore rules during traversal."
msgstr ".gitignore-Regeln beim Verzeichnisdurchlauf nicht beachten."

#: src/findfmt/cli/help.py:115
msgid "Load and enforce an external gitignore file across the traversal scope."
msgstr "Eine externe gitignore-Datei laden und im gesamten Suchbereich anwenden."

#: src/findfmt/cli/help.py:117
msgid ""
"Read directory listing from a file or standard input ('-') instead of "
"scanning filesystem."
msgstr ""
"Verzeichnisliste aus einer Datei oder der Standardeingabe ('-') lesen, "
"anstatt das Dateisystem zu durchsuchen."

#: src/findfmt/cli/help.py:119
msgid ""
"Enforce offline extension- and filename-only identification without disk "
"IO."
msgstr ""
"Offline-Erkennung ausschließlich anhand von Dateiendung und Dateiname "
"ohne Festplatten-E/A erzwingen."

#: src/findfmt/cli/help.py:120
msgid "Include hidden files and directories."
msgstr "Versteckte Dateien und Verzeichnisse einbeziehen."

#: src/findfmt/cli/help.py:121
msgid "Follow symbolic links during traversal."
msgstr "Symbolischen Verknüpfungen beim Verzeichnisdurchlauf folgen."

#: src/findfmt/cli/help.py:122
msgid "List directories only, suppressing regular file entries."
msgstr "Nur Verzeichnisse auflisten und reguläre Dateieinträge ausblenden."

#: src/findfmt/cli/help.py:123
msgid "Confine traversal to the root filesystem device."
msgstr "Verzeichnisdurchlauf auf das Ausgangs-Dateisystemgerät beschränken."

#: src/findfmt/cli/help.py:124
msgid "Restrict descent to a maximum directory depth level."
msgstr "Verzeichnisabstieg auf eine maximale Verzeichnistiefe begrenzen."

#: src/findfmt/cli/help.py:125
msgid "Skip directories exceeding this entry count threshold."
msgstr ""
"Verzeichnisse überspringen, die diesen Schwellenwert an Einträgen "
"überschreiten."

#: src/findfmt/cli/help.py:126
msgid "Omit empty directories and directories with zero matching files."
msgstr "Leere Verzeichnisse und Verzeichnisse ohne passende Dateien auslassen."

#: src/findfmt/cli/help.py:127
msgid ""
"Include files matching wildcard or glob pattern (supports multiple -P and"
" '|')."
msgstr ""
"Dateien einbeziehen, die dem Platzhalter- oder Glob-Muster entsprechen "
"(unterstützt mehrere -P und '|')."

#: src/findfmt/cli/help.py:129
msgid ""
"Exclude files matching wildcard or glob pattern (supports multiple -I and"
" '|')."
msgstr ""
"Dateien ausschließen, die dem Platzhalter- oder Glob-Muster entsprechen "
"(unterstützt mehrere -I und '|')."

#: src/findfmt/cli/help.py:131
msgid "Apply case-insensitive matching across -P and -I patterns."
msgstr "Groß-/Kleinschreibung bei -P- und -I-Mustern ignorieren."

#: src/findfmt/cli/help.py:132
msgid "Match directory names against patterns; matched dirs inherit to children."
msgstr ""
"Verzeichnisnamen mit Mustern abgleichen; passende Verzeichnisse vererben "
"sich auf untergeordnete Elemente."

#: src/findfmt/cli/help.py:133
msgid "Sort files by criteria: name, version, time (mtime), ctime, size, none."
msgstr ""
"Dateien nach Kriterium sortieren: name, version, time (mtime), ctime, "
"size, none."

#: src/findfmt/cli/help.py:134
msgid "Invert the active sort order."
msgstr "Aktive Sortierreihenfolge umkehren."

#: src/findfmt/cli/help.py:136
msgid ""
"Do not sort entries; yield files in raw filesystem order (equivalent to "
"--sort=none)."
msgstr ""
"Einträge nicht sortieren; Dateien in unveränderter Dateisystemreihenfolge"
" ausgeben (entspricht --sort=none)."

#: src/findfmt/cli/help.py:138
msgid "List directories before files within each directory level."
msgstr "Verzeichnisse innerhalb jeder Verzeichnisebene vor Dateien auflisten."

#: src/findfmt/cli/help.py:139
msgid "List files before directories within each directory level."
msgstr "Dateien innerhalb jeder Verzeichnisebene vor Verzeichnissen auflisten."

#: src/findfmt/cli/help.py:141
msgid ""
"Output format (text, json, jsonl, yaml, ipynb, csv, csv-table, tsv, "
"markdown, md, rst, table, tree, xml, html, ndjson)."
msgstr ""
"Ausgabeformat (text, json, jsonl, yaml, ipynb, csv, csv-table, tsv, "
"markdown, md, rst, table, tree, xml, html, ndjson)."

#: src/findfmt/cli/help.py:145
msgid ""
"Output structured JSON representation of the file tree and "
"classifications (equivalent to --format json)."
msgstr ""
"Strukturierte JSON-Darstellung des Dateibaums und der Klassifizierungen "
"ausgeben (entspricht --format json)."

#: src/findfmt/cli/help.py:148
msgid "Output directory tree as an XML document (equivalent to --format xml)."
msgstr "Verzeichnisbaum als XML-Dokument ausgeben (entspricht --format xml)."

#: src/findfmt/cli/help.py:149
msgid "Output directory tree as an HTML document with HTTP reference hyperlinks."
msgstr "Verzeichnisbaum als HTML-Dokument mit HTTP-Referenz-Hyperlinks ausgeben."

#: src/findfmt/cli/help.py:151
msgid ""
"Read and insert contents of specified HTML fragment file prior to "
"directory listing."
msgstr ""
"Inhalt der angegebenen HTML-Fragmentdatei lesen und vor der "
"Verzeichnisliste einfügen."

#: src/findfmt/cli/help.py:153
msgid ""
"Read and insert contents of specified HTML fragment file after directory "
"listing."
msgstr ""
"Inhalt der angegebenen HTML-Fragmentdatei lesen und nach der "
"Verzeichnisliste einfügen."

#: src/findfmt/cli/help.py:154
msgid ""
"Set title and <h1> heading for HTML document output (default: 'Directory "
"Tree')."
msgstr ""
"Titel und <h1>-Überschrift für die HTML-Dokumentausgabe festlegen "
"(Standard: 'Directory Tree')."

#: src/findfmt/cli/help.py:155
msgid ""
"Suppress hyperlink anchors in HTML document output, rendering plain text "
"paths."
msgstr ""
"Hyperlink-Anker in der HTML-Dokumentausgabe unterdrücken und Pfade als "
"Klartext darstellen."

#: src/findfmt/cli/help.py:156
msgid ""
"Wrap paths in standard OSC 8 clickable terminal hyperlink escape "
"sequences."
msgstr ""
"Pfade in anklickbare Standard-OSC-8-Terminal-Hyperlink-Escape-Sequenzen "
"einbetten."

#: src/findfmt/cli/help.py:158
msgid ""
"URI schema for terminal hyperlinks (defaults to 'file://', e.g. "
"'vscode://file/', 'cursor://file/', 'subl://')."
msgstr ""
"URI-Schema für Terminal-Hyperlinks (Standard: 'file://', z. B. "
"'vscode://file/', 'cursor://file/', 'subl://')."

#: src/findfmt/cli/help.py:162
msgid ""
"URI authority component for terminal hyperlinks (e.g. 'localhost' or "
"remote hostname)."
msgstr ""
"URI-Authority-Komponente für Terminal-Hyperlinks (z. B. 'localhost' oder "
"entfernter Hostname)."

#: src/findfmt/cli/help.py:164
msgid "Send command output directly to a file rather than standard output."
msgstr ""
"Befehlsausgabe direkt in eine Datei statt auf die Standardausgabe "
"schreiben."

#: src/findfmt/cli/help.py:165
msgid ""
"Render output in a hierarchical directory tree (equivalent to --format "
"tree)."
msgstr ""
"Ausgabe als hierarchischen Verzeichnisbaum darstellen (entspricht "
"--format tree)."

#: src/findfmt/cli/help.py:167
msgid ""
"Border style for table, csv-table, or rst output (e.g. rounded, simple, "
"minimal, double, heavy, markdown, ascii, cp437, square, grid)."
msgstr ""
"Rahmenstil für table-, csv-table- oder rst-Ausgabe (z. B. rounded, "
"simple, minimal, double, heavy, markdown, ascii, cp437, square, grid)."

#: src/findfmt/cli/help.py:171
msgid ""
"Prefix formula trigger characters (=, +, -, @, TAB, CR) in CSV/TSV cells "
"with a single quote to prevent spreadsheet formula injection."
msgstr ""
"Formel-Auslösezeichen (=, +, -, @, TAB, CR) in CSV/TSV-Zellen ein "
"einfaches Anführungszeichen voranstellen, um Tabellenkalkulations-Formel-"
"Injection zu verhindern."

#: src/findfmt/cli/help.py:174
msgid "Enable or disable interactive paging (defaults to auto-paging on TTY)."
msgstr ""
"Interaktive Seitenanzeige (Pager) aktivieren oder deaktivieren (Standard:"
" automatisches Paging auf TTY)."

#: src/findfmt/cli/help.py:176
msgid ""
"Do not print indentation lines in tree format and strip extraneous "
"whitespace in structured formats."
msgstr ""
"Keine Einrückungslinien im Baumformat ausgeben und überflüssige "
"Leerzeichen in strukturierten Formaten entfernen."

#: src/findfmt/cli/help.py:180
msgid ""
"Use ANSI/VT100 alternate character set line drawing escapes for tree "
"indentation lines."
msgstr ""
"ANSI/VT100-Linienzeichnungs-Escape-Sequenzen für Baumeinrückungslinien "
"verwenden."

#: src/findfmt/cli/help.py:182
msgid "Use CP437 (IBM-PC) console graphics characters for tree indentation lines."
msgstr "CP437-(IBM-PC)-Konsolengrafikzeichen für Baumeinrückungslinien verwenden."

#: src/findfmt/cli/help.py:184
msgid ""
"Force enable or disable ANSI color output (defaults to auto-detection "
"with NO_COLOR compliance)."
msgstr ""
"ANSI-Farbausgabe erzwingen oder deaktivieren (Standard: automatische "
"Erkennung unter Beachtung von NO_COLOR)."

#: src/findfmt/cli/help.py:187
msgid "Output absolute paths rather than paths relative to the traversal root."
msgstr "Absolute Pfade statt Pfaden relativ zum Ausgangsverzeichnis ausgeben."

#: src/findfmt/cli/help.py:189
msgid ""
"Prepend input search path prefix to relative output paths rather than "
"stripping the root."
msgstr ""
"Präfix des Eingabesuchpfads relativen Ausgabepfaden voranstellen, anstatt"
" das Wurzelverzeichnis zu entfernen."

#: src/findfmt/cli/help.py:191
msgid "Delimit path outputs with a NUL (\\0) character instead of a newline."
msgstr ""
"Pfadausgaben mit einem NUL-Zeichen (\\0) statt einem Zeilenumbruch "
"trennen."

#: src/findfmt/cli/help.py:192
msgid "Display identified tags alongside each matched path."
msgstr "Erkannte Tags neben jedem gefundenen Pfad anzeigen."

#: src/findfmt/cli/help.py:193
msgid "Print summary match statistics to stderr."
msgstr "Zusammenfassungsstatistiken der Treffer auf stderr ausgeben."

#: src/findfmt/cli/help.py:194
msgid "Exit with status code 1 if no matching files are found."
msgstr "Mit Statuscode 1 beenden, wenn keine passenden Dateien gefunden werden."

#: src/findfmt/cli/help.py:195
msgid ""
"Print file type and permissions in standard ls -l format (e.g. -rw-r--"
"r--)."
msgstr ""
"Dateityp und Berechtigungen im Standardformat von ls -l ausgeben (z. B. "
"-rw-r--r--)."

#: src/findfmt/cli/help.py:196
msgid "Print the username, or UID if username is unavailable, of the file owner."
msgstr ""
"Benutzernamen oder UID (falls kein Benutzername verfügbar ist) des "
"Dateieigentümers ausgeben."

#: src/findfmt/cli/help.py:197
msgid ""
"Print the group name, or GID if group name is unavailable, of the file "
"group."
msgstr ""
"Gruppennamen oder GID (falls kein Gruppenname verfügbar ist) der "
"Dateigruppe ausgeben."

#: src/findfmt/cli/help.py:198
msgid "Print filesystem inode number (st_ino)."
msgstr "Inode-Nummer des Dateisystems (st_ino) ausgeben."

#: src/findfmt/cli/help.py:199
msgid "Print filesystem device number (st_dev)."
msgstr "Gerätenummer des Dateisystems (st_dev) ausgeben."

#: src/findfmt/cli/help.py:200
msgid "Print file size in bytes."
msgstr "Dateigröße in Bytes ausgeben."

#: src/findfmt/cli/help.py:202
msgid ""
"Print file sizes in human-readable binary format (e.g. 1KiB, 234MiB, "
"2GiB)."
msgstr ""
"Dateigrößen im menschenlesbaren Binärformat ausgeben (z. B. 1KiB, 234MiB,"
" 2GiB)."

#: src/findfmt/cli/help.py:204
msgid ""
"Print file sizes in human-readable SI metric format (e.g. 1kB, 234MB, "
"2GB)."
msgstr ""
"Dateigrößen im menschenlesbaren metrischen SI-Format ausgeben (z. B. 1kB,"
" 234MB, 2GB)."

#: src/findfmt/cli/help.py:205
msgid ""
"Report directory size as the recursive sum of all child files and "
"subdirectories."
msgstr ""
"Verzeichnisgröße als rekursive Summe aller enthaltenen Dateien und "
"Unterverzeichnisse ausweisen."

#: src/findfmt/cli/help.py:206
msgid "Print the date and time of the last modification (st_mtime)."
msgstr "Datum und Uhrzeit der letzten Änderung (st_mtime) ausgeben."

#: src/findfmt/cli/help.py:207
msgid "Print the date and time of the last status change (st_ctime)."
msgstr "Datum und Uhrzeit der letzten Statusänderung (st_ctime) ausgeben."

#: src/findfmt/cli/help.py:209
msgid ""
"Specify date and time output format string (strftime syntax; implies -D "
"unless --ctime)."
msgstr ""
"Formatzeichenkette für Datums- und Zeitausgabe angeben (strftime-Syntax; "
"impliziert -D, sofern nicht --ctime gesetzt ist)."

#: src/findfmt/cli/help.py:212
msgid ""
"Append file type indicator to filenames (* for executable, / for "
"directory, @ for symlink, = for socket, | for FIFO, > for door)."
msgstr ""
"Dateityp-Indikator an Dateinamen anhängen (* für ausführbar, / für "
"Verzeichnis, @ für Symlink, = für Socket, | für FIFO, > für Door)."

#: src/findfmt/cli/help.py:215
msgid "Replace non-printable control characters in filenames with '?'."
msgstr "Nicht druckbare Steuerzeichen in Dateinamen durch '?' ersetzen."

#: src/findfmt/cli/help.py:216
msgid ""
"Print non-printable control characters literally as raw bytes without "
"masking."
msgstr ""
"Nicht druckbare Steuerzeichen unverändert als Rohbytes ohne Maskierung "
"ausgeben."

#: src/findfmt/cli/help.py:217
msgid ""
"Enclose filenames in double quotes, escaping embedded quotes and "
"backslashes."
msgstr ""
"Dateinamen in doppelte Anführungszeichen setzen und enthaltene "
"Anführungszeichen sowie Backslashes maskieren."

#: src/findfmt/cli/help.py:218
msgid "List all known classification tags supported by the engine and exit."
msgstr ""
"Alle von der Engine unterstützten Klassifizierungs-Tags auflisten und "
"beenden."

#: src/findfmt/cli/help.py:219
msgid "Include extended runtime diagnostics when used with --version."
msgstr "Erweiterte Laufzeitdiagnose bei Verwendung mit --version einbeziehen."

#: src/findfmt/cli/help.py:220
msgid "Display runtime environment diagnostics and exit."
msgstr "Diagnoseinformationen der Laufzeitumgebung anzeigen und beenden."

#: src/findfmt/cli/help.py:221
msgid "Display the version of findfmt and exit."
msgstr "Version von findfmt anzeigen und beenden."

#: src/findfmt/cli/help.py:223
msgid ""
"Display comprehensive help reference including environment variables, "
"exit codes, and examples."
msgstr ""
"Umfassende Hilfereferenz einschließlich Umgebungsvariablen, Exit-Codes "
"und Beispielen anzeigen."

#: src/findfmt/cli/help.py:226
msgid "Path to custom configuration file overriding defaults."
msgstr ""
"Pfad zu einer benutzerdefinierten Konfigurationsdatei, die Standardwerte "
"überschreibt."

#: src/findfmt/cli/help.py:227
msgid "Suppress loading any configuration file."
msgstr "Laden jeglicher Konfigurationsdatei unterdrücken."

#: src/findfmt/cli/help.py:228
msgid "Display resolved configuration settings and exit."
msgstr "Aufgelöste Konfigurationseinstellungen anzeigen und beenden."

#: src/findfmt/cli/help.py:229
msgid ""
"Explicitly set locale for translations and display (e.g. 'en_US', 'es', "
"'C')."
msgstr ""
"Gebietsschema (Locale) für Übersetzungen und Anzeige explizit festlegen "
"(z. B. 'en_US', 'es', 'C')."

#: src/findfmt/cli/help.py:238
msgid "Comprehensive CLI Reference"
msgstr "Umfassende CLI-Referenz"

#: src/findfmt/cli/help.py:240
msgid ""
"Usage: findfmt [OPTIONS] [paths]...\n"
"\n"
"Tag Filtering:\n"
"  --type, -t, --tag <str>       Tag or comma-separated tags to match.\n"
"  --exclude, -e, --exclude-tag  Tag or comma-separated tags to exclude.\n"
"  --all-tags / --no-all-tags    Require matching ALL specified tags\n"
"                                [default: no-all-tags].\n"
"\n"
"Traversal Controls:\n"
"  --pattern, -P <pattern>       Include files matching wildcard or glob "
"pattern.\n"
"  --exclude-pattern, -I <pat>   Exclude files matching wildcard or glob "
"pattern.\n"
"  --ignore-case                 Case-insensitive pattern matching across "
"-P and -I.\n"
"  --match-dirs, --matchdirs     Match directory names; matched dirs "
"inherit to children.\n"
"  --shebang <str>               Filter files by shebang pattern.\n"
"  --dirs-only, -d               List directories only, suppressing "
"regular files.\n"
"  --max-depth, -L <level>       Restrict descent to maximum depth level.\n"
"  --follow-links, --follow-symlinks, -l\n"
"                                Follow directory symlinks with loop "
"detection.\n"
"  --symlinks / --no-symlinks    Alias for --follow-links / --no-follow-"
"links.\n"
"  --one-file-system, -x         Confine traversal to root filesystem "
"device.\n"
"  --filelimit <limit>           Skip directories exceeding entry count "
"threshold.\n"
"  --prune                       Omit directories containing zero matching"
" files.\n"
"  --no-ignore / --ignore        Do not respect .gitignore rules [default:"
" ignore].\n"
"  --gitignore-file <path>       Apply custom ignore file across traversal"
" scope.\n"
"  --from-file, --fromfile <p>   Read paths from file or standard input "
"('-').\n"
"  --offline                     Enforce offline filename identification.\n"
"  --all, --hidden, -a           Include hidden files and dirs [default: "
"no-hidden].\n"
"  --sort <criteria>             Sort files (name, version, time, ctime, "
"size, none)\n"
"                                [default: name].\n"
"  --reverse, -r                 Invert active sort order.\n"
"  --unsorted, -U                Raw directory order without sorting.\n"
"  --dirsfirst                   List directories before files within "
"directory levels.\n"
"  --filesfirst                  List files before directories within "
"directory levels.\n"
"\n"
"Output Formatting:\n"
"  --format, -f <fmt>            Output format (text, json, jsonl, yaml, "
"ipynb,\n"
"                                csv, csv-table, tsv, markdown, rst, "
"table, tree,\n"
"                                xml, html) [default: text].\n"
"  --json, -J / --no-json        Output structured JSON representation.\n"
"  --xml, -X / --no-xml          Output directory tree as an XML document."
"\n"
"  --html, -H <baseHREF>         Output directory tree as an HTML "
"document.\n"
"  --intro <path>                Prepend custom HTML fragment before "
"listing.\n"
"  --outro <path>                Append custom HTML fragment after "
"listing.\n"
"  --title, -T <title>           Set title and <h1> heading for HTML "
"output.\n"
"  --nolinks / --no-nolinks      Suppress hyperlink anchors in HTML "
"output.\n"
"  --hyperlink / --no-hyperlink  Wrap paths in OSC 8 terminal hyperlinks.\n"
"  --hyperlink-schema <schema>   URI schema prefix (default: file://).\n"
"  --hyperlink-authority <auth>  URI authority override (e.g. localhost).\n"
"  --output, -o <path>           Send command output directly to a file.\n"
"  --csv-safe / --no-csv-safe    Neutralize spreadsheet formulas in "
"CSV/TSV cells.\n"
"  --tree / --no-tree            Render output in hierarchical tree view.\n"
"  --table-style <style>         Border style (rounded, cp437, ascii, "
"etc.).\n"
"  --pager / --no-pager          Enable or disable interactive paging.\n"
"  --no-indent, -i / --indent    Omit indentation lines and strip "
"extraneous whitespace.\n"
"  --ansi-lines, -A              Use ANSI/VT100 line drawing escapes.\n"
"  --cp437, -S                   Use CP437 console graphics line drawing "
"characters.\n"
"  --color, -C / --no-color, -n  Force enable or disable ANSI color "
"output.\n"
"  --absolute, --full-path       Output absolute paths rather than "
"relative paths.\n"
"  --relative, --relative-path   Prepend input search path prefix to "
"relative paths.\n"
"  --permissions, -p             Format file mode in standard ls -l style."
"\n"
"  --user, -u                    Display file owner username (falling back"
" to UID).\n"
"  --group, -g                   Display file owner group (falling back to"
" GID).\n"
"  --inodes                      Print filesystem inode number (st_ino).\n"
"  --device                      Print filesystem device number (st_dev).\n"
"  --size / --no-size            Print file size in bytes.\n"
"  --human-readable, -h          Print sizes in human-readable binary "
"format.\n"
"  --si / --no-si                Print sizes in human-readable SI metric "
"format.\n"
"  --du, --accumulate-size       Accumulate recursive directory disk "
"usage.\n"
"  --mtime, -D                   Display last modification time.\n"
"  --ctime                       Display last status change time.\n"
"  --time-format, --timefmt <f>  Date and time format string (strftime "
"syntax).\n"
"  --classify, -F                Append indicator (/ @ * = | >) to "
"filenames.\n"
"  --hide-control-chars, -q      Mask non-printable control characters "
"with '?'.\n"
"  --literal, -N                 Print non-printable characters literally."
"\n"
"  --quote-name, -Q              Enclose filenames in double quotes.\n"
"  --print0, -0 / --no-print0    Delimit with NUL (\\0) byte [default: no-"
"print0].\n"
"  --list-tags / --no-list-tags  Display identified tags [default: no-"
"list-tags].\n"
"  --summary, -s / --no-summary  Print summary statistics [default: no-"
"summary].\n"
"  --exit-status                 Exit with code 1 if no matching files are"
" found.\n"
"\n"
"Help & Diagnostics:\n"
"  --config <path>               Path to custom configuration file "
"overriding defaults.\n"
"  --no-config                   Suppress loading any configuration file.\n"
"  --show-config                 Display resolved configuration settings "
"and exit.\n"
"  --known-tags                  List all known classification tags and "
"exit.\n"
"  --locale, --lang <locale>     Set display locale (e.g. 'en_US', 'es', "
"'C').\n"
"  --version, -v, -V             Display version (use with --verbose for "
"diagnostics).\n"
"  --verbose                     Include extended runtime diagnostics with"
" --version.\n"
"  --diagnostics                 Display runtime environment diagnostics "
"and exit.\n"
"  --help-all                    Display this comprehensive reference and "
"exit.\n"
"  --help                        Display categorized help summary and "
"exit.\n"
"\n"
"Command Wrappers:\n"
"  findfiles [PATHS...]          Equivalent to findfmt --hidden\n"
"  findfilemime [PATHS...]       Equivalent to findfmt --hidden --list-"
"tags\n"
"  findfilefmt [TAG] [PATHS...]  Equivalent to findfmt --hidden --tag TAG\n"
"  findshebang [INTERP]...       Equivalent to findfmt --hidden --shebang "
"INTERPRETER\n"
"  findfmt0 [PATHS...]           Equivalent to findfmt --hidden --print0\n"
"  findsummary [PATHS...]        Equivalent to findfmt --hidden --summary\n"
"\n"
"POSIX Double-Dash (--) Terminator:\n"
"  Arguments following '--' are treated strictly as positional paths:\n"
"  $ findfmt -- -hyphen-dir/\n"
"  $ findfilefmt python -- -weird-name/\n"
"\n"
"Environment Variables:\n"
"  NO_COLOR                      When set, suppresses colored output "
"(https://no-color.org).\n"
"  CLICOLOR                      When set to 0, suppresses ANSI colors; 1 "
"enables colors.\n"
"  CLICOLOR_FORCE                When non-zero, forces color output even "
"when piped.\n"
"  FINDFMT_CONFIG                Path to custom configuration file "
"overriding defaults.\n"
"\n"
"Exit Codes:\n"
"  0                             Success, even when no files match (see "
"--exit-status).\n"
"  1                             Runtime error, or no matches with --exit-"
"status.\n"
"  2                             Invalid command-line usage, options, or "
"config file.\n"
"  130                           Interrupted by SIGINT (Ctrl+C).\n"
"\n"
"Workflow Examples:\n"
"  $ findfmt -t python                     # Find Python files in current "
"repository\n"
"  $ findfmt --shebang bash scripts/       # Find bash scripts in scripts/"
"\n"
"  $ findfmt -t python -t executable --all-tags  # Require BOTH tags\n"
"  $ findfiles --no-hidden                 # Traverse files without hidden"
" files\n"
"  $ findfilefmt json                      # Shortcut: find JSON files\n"
"  $ findshebang python                    # Shortcut: find Python shebang"
" scripts\n"
"  $ findfmt0 -t python | xargs -0 flake8  # Pipe NUL-delimited paths "
"safely\n"
"  $ findsummary                           # Print summary match "
"statistics to stderr\n"
msgstr ""
"Aufruf: findfmt [OPTIONS] [paths]...\n"
"\n"
"Tag-Filterung:\n"
"  --type, -t, --tag <str>       Abzugleichendes Tag oder kommagetrennte "
"Tags.\n"
"  --exclude, -e, --exclude-tag  Auszuschließendes Tag oder kommagetrennte"
" Tags.\n"
"  --all-tags / --no-all-tags    Übereinstimmung mit ALLEN angegebenen "
"Tags verlangen\n"
"                                [Standard: no-all-tags].\n"
"\n"
"Verzeichnisdurchlauf:\n"
"  --pattern, -P <pattern>       Dateien einbeziehen, die dem Glob-Muster "
"entsprechen.\n"
"  --exclude-pattern, -I <pat>   Dateien ausschließen, die dem Glob-Muster"
" entsprechen.\n"
"  --ignore-case                 Groß-/Kleinschreibung bei -P und -I "
"ignorieren.\n"
"  --match-dirs, --matchdirs     Verzeichnisnamen abgleichen; Vererbung an"
" Unterelemente.\n"
"  --shebang <str>               Dateien nach Shebang-Muster filtern.\n"
"  --dirs-only, -d               Nur Verzeichnisse auflisten, reguläre "
"Dateien ausblenden.\n"
"  --max-depth, -L <level>       Abstieg auf maximale Verzeichnistiefe "
"begrenzen.\n"
"  --follow-links, --follow-symlinks, -l\n"
"                                Verzeichnis-Symlinks mit "
"Schleifenerkennung folgen.\n"
"  --symlinks / --no-symlinks    Alias für --follow-links / --no-follow-"
"links.\n"
"  --one-file-system, -x         Durchlauf auf das Ausgangs-Dateisystem "
"beschränken.\n"
"  --filelimit <limit>           Verzeichnisse über diesem "
"Eintragsschwellenwert überspringen.\n"
"  --prune                       Verzeichnisse ohne passende Dateien "
"auslassen.\n"
"  --no-ignore / --ignore        .gitignore-Regeln nicht beachten "
"[Standard: ignore].\n"
"  --gitignore-file <path>       Benutzerdefinierte Ignore-Datei im "
"Suchbereich anwenden.\n"
"  --from-file, --fromfile <p>   Pfade aus Datei oder Standardeingabe "
"('-') lesen.\n"
"  --offline                     Offline-Dateinamenerkennung erzwingen.\n"
"  --all, --hidden, -a           Versteckte Dateien und Verzeichnisse "
"einbeziehen [Standard: no-hidden].\n"
"  --sort <criteria>             Dateien sortieren (name, version, time, "
"ctime, size, none)\n"
"                                [Standard: name].\n"
"  --reverse, -r                 Aktive Sortierreihenfolge umkehren.\n"
"  --unsorted, -U                Rohreihenfolge des Verzeichnisses ohne "
"Sortierung.\n"
"  --dirsfirst                   Verzeichnisse innerhalb jeder Ebene vor "
"Dateien auflisten.\n"
"  --filesfirst                  Dateien innerhalb jeder Ebene vor "
"Verzeichnissen auflisten.\n"
"\n"
"Ausgabeformatierung:\n"
"  --format, -f <fmt>            Ausgabeformat (text, json, jsonl, yaml, "
"ipynb,\n"
"                                csv, csv-table, tsv, markdown, rst, "
"table, tree,\n"
"                                xml, html) [Standard: text].\n"
"  --json, -J / --no-json        Strukturierte JSON-Darstellung ausgeben.\n"
"  --xml, -X / --no-xml          Verzeichnisbaum als XML-Dokument "
"ausgeben.\n"
"  --html, -H <baseHREF>         Verzeichnisbaum als HTML-Dokument "
"ausgeben.\n"
"  --intro <path>                Benutzerdefiniertes HTML-Fragment vor der"
" Liste einfügen.\n"
"  --outro <path>                Benutzerdefiniertes HTML-Fragment nach "
"der Liste anfügen.\n"
"  --title, -T <title>           Titel und <h1>-Überschrift für HTML-"
"Ausgabe festlegen.\n"
"  --nolinks / --no-nolinks      Hyperlink-Anker in HTML-Ausgabe "
"unterdrücken.\n"
"  --hyperlink / --no-hyperlink  Pfade in OSC-8-Terminal-Hyperlinks "
"einbetten.\n"
"  --hyperlink-schema <schema>   URI-Schema-Präfix (Standard: file://).\n"
"  --hyperlink-authority <auth>  URI-Authority überschreiben (z. B. "
"localhost).\n"
"  --output, -o <path>           Befehlsausgabe direkt in eine Datei "
"schreiben.\n"
"  --csv-safe / --no-csv-safe    Tabellenkalkulationsformeln in CSV/TSV-"
"Zellen entschärfen.\n"
"  --tree / --no-tree            Ausgabe als hierarchische Baumansicht "
"darstellen.\n"
"  --table-style <style>         Rahmenstil (rounded, cp437, ascii usw.).\n"
"  --pager / --no-pager          Interaktiven Pager aktivieren oder "
"deaktivieren.\n"
"  --no-indent, -i / --indent    Einrückungslinien und überflüssige "
"Leerzeichen weglassen.\n"
"  --ansi-lines, -A              ANSI/VT100-Linienzeichnungssequenzen "
"verwenden.\n"
"  --cp437, -S                   CP437-Konsolengrafikzeichen für Linien "
"verwenden.\n"
"  --color, -C / --no-color, -n  ANSI-Farbausgabe erzwingen oder "
"deaktivieren.\n"
"  --absolute, --full-path       Absolute Pfade statt relativer Pfade "
"ausgeben.\n"
"  --relative, --relative-path   Eingabesuchpfad-Präfix relativen Pfaden "
"voranstellen.\n"
"  --permissions, -p             Dateimodus im Standardstil von ls -l "
"formatieren.\n"
"  --user, -u                    Benutzernamen des Eigentümers anzeigen "
"(Fallback: UID).\n"
"  --group, -g                   Gruppennamen des Eigentümers anzeigen "
"(Fallback: GID).\n"
"  --inodes                      Dateisystem-Inode-Nummer (st_ino) "
"ausgeben.\n"
"  --device                      Dateisystem-Gerätenummer (st_dev) "
"ausgeben.\n"
"  --size / --no-size            Dateigröße in Bytes ausgeben.\n"
"  --human-readable, -h          Größen im menschenlesbaren Binärformat "
"ausgeben.\n"
"  --si / --no-si                Größen im menschenlesbaren metrischen SI-"
"Format ausgeben.\n"
"  --du, --accumulate-size       Rekursive Verzeichnisbelegung "
"aufsummieren.\n"
"  --mtime, -D                   Zeitpunkt der letzten Änderung anzeigen.\n"
"  --ctime                       Zeitpunkt der letzten Statusänderung "
"anzeigen.\n"
"  --time-format, --timefmt <f>  Datums- und Zeitformatzeichenkette "
"(strftime-Syntax).\n"
"  --classify, -F                Typindikator (/ @ * = | >) an Dateinamen "
"anhängen.\n"
"  --hide-control-chars, -q      Nicht druckbare Steuerzeichen mit '?' "
"maskieren.\n"
"  --literal, -N                 Nicht druckbare Zeichen unverändert "
"ausgeben.\n"
"  --quote-name, -Q              Dateinamen in doppelte Anführungszeichen "
"einschließen.\n"
"  --print0, -0 / --no-print0    Mit NUL-Byte (\\0) trennen [Standard: no-"
"print0].\n"
"  --list-tags / --no-list-tags  Erkannte Tags anzeigen [Standard: no-"
"list-tags].\n"
"  --summary, -s / --no-summary  Zusammenfassungsstatistiken ausgeben "
"[Standard: no-summary].\n"
"  --exit-status                 Mit Code 1 beenden, wenn keine Dateien "
"gefunden werden.\n"
"\n"
"Hilfe & Diagnose:\n"
"  --config <path>               Pfad zu benutzerdefinierter "
"Konfigurationsdatei.\n"
"  --no-config                   Laden jeglicher Konfigurationsdatei "
"unterdrücken.\n"
"  --show-config                 Aufgelöste Konfigurationseinstellungen "
"anzeigen und beenden.\n"
"  --known-tags                  Alle bekannten Klassifizierungs-Tags "
"auflisten und beenden.\n"
"  --locale, --lang <locale>     Anzeige-Gebietsschema festlegen (z. B. "
"'en_US', 'es', 'C').\n"
"  --version, -v, -V             Version anzeigen (mit --verbose für "
"Diagnose).\n"
"  --verbose                     Erweiterte Laufzeitdiagnose mit "
"--version.\n"
"  --diagnostics                 Laufzeitumgebungs-Diagnose anzeigen und "
"beenden.\n"
"  --help-all                    Diese umfassende Referenz anzeigen und "
"beenden.\n"
"  --help                        Kategorisierte Hilfeübersicht anzeigen "
"und beenden.\n"
"\n"
"Befehls-Wrapper:\n"
"  findfiles [PATHS...]          Entspricht findfmt --hidden\n"
"  findfilemime [PATHS...]       Entspricht findfmt --hidden --list-tags\n"
"  findfilefmt [TAG] [PATHS...]  Entspricht findfmt --hidden --tag TAG\n"
"  findshebang [INTERP]...       Entspricht findfmt --hidden --shebang "
"INTERPRETER\n"
"  findfmt0 [PATHS...]           Entspricht findfmt --hidden --print0\n"
"  findsummary [PATHS...]        Entspricht findfmt --hidden --summary\n"
"\n"
"POSIX-Doppelbindestrich (--) als Begrenzer:\n"
"  Argumente nach '--' werden strikt als Positionspfade behandelt:\n"
"  $ findfmt -- -hyphen-dir/\n"
"  $ findfilefmt python -- -weird-name/\n"
"\n"
"Umgebungsvariablen:\n"
"  NO_COLOR                      Unterdrückt Farbausgabe, wenn gesetzt "
"(https://no-color.org).\n"
"  CLICOLOR                      Bei 0 werden ANSI-Farben unterdrückt; 1 "
"aktiviert Farben.\n"
"  CLICOLOR_FORCE                Erzwingt Farbausgabe bei Werten ungleich "
"0 auch in Pipes.\n"
"  FINDFMT_CONFIG                Pfad zu benutzerdefinierter "
"Konfigurationsdatei.\n"
"\n"
"Exit-Codes:\n"
"  0                             Erfolg, auch ohne Treffer (siehe --exit-"
"status).\n"
"  1                             Laufzeitfehler oder keine Treffer bei "
"--exit-status.\n"
"  2                             Ungültiger Befehlszeilenaufruf, Optionen "
"oder Konfiguration.\n"
"  130                           Abgebrochen durch SIGINT (Strg+C).\n"
"\n"
"Praxisbeispiele:\n"
"  $ findfmt -t python                     # Python-Dateien im aktuellen "
"Repository finden\n"
"  $ findfmt --shebang bash scripts/       # Bash-Skripte in scripts/ "
"finden\n"
"  $ findfmt -t python -t executable --all-tags  # BEIDE Tags erforderlich"
"\n"
"  $ findfiles --no-hidden                 # Dateien ohne versteckte "
"Dateien durchlaufen\n"
"  $ findfilefmt json                      # Kurzform: JSON-Dateien finden"
"\n"
"  $ findshebang python                    # Kurzform: Python-Shebang-"
"Skripte finden\n"
"  $ findfmt0 -t python | xargs -0 flake8  # NUL-getrennte Pfade sicher "
"weiterleiten\n"
"  $ findsummary                           # Zusammenfassungsstatistiken "
"auf stderr ausgeben\n"

