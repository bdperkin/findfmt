"Error: Unknown configuration key '{key}' in '{path}'. Did you mean "
"'{suggestion}'?"
msgstr ""
"Fehler: Unbekannter Konfigurationsschlüssel '{key}' in '{path}'. Meinten "
"Sie '{suggestion}'?"

#: src/findfmt/cli/config_schema.py:323
#, python-brace-format
msgid "Error: Unknown configuration key '{key}' in '{path}'."
msgstr "Fehler: Unbekannter Konfigurationsschlüssel '{key}' in '{path}'."

#: src/findfmt/cli/config_schema.py:387
