msgstr ""
"Warnung: Konfigurationsschlüssel '{key}' in '{path}' ist veraltet und "
"wird in v2.0.0 entfernt; verwenden Sie stattdessen 'format = \"{fmt}\"'."

#: src/findfmt/cli/config_schema.py:316
#, python-brace-format
