#: src/findfmt/exceptions.py:39
#, python-brace-format
msgid "Unsupported output format: '{format}'. Expected one of: {valid_formats}"
msgstr ""
"Nicht unterstütztes Ausgabeformat: '{format}'. Erwartet wird eines von: "
"{valid_formats}"

#: src/findfmt/exceptions.py:57
#, python-brace-format
msgid "Unsupported RST table style: '{style}'. Expected 'grid' or 'simple'."
msgstr ""
"Nicht unterstützter RST-Tabellenstil: '{style}'. Erwartet wird 'grid' "
"oder 'simple'."

#: src/findfmt/exceptions.py:76
#, python-brace-format
msgid "Unsupported table style: '{style}'. Expected one of: {valid_styles}"
msgstr ""
"Nicht unterstützter Tabellenstil: '{style}'. Erwartet wird einer von: "
"{valid_styles}"

#: src/findfmt/exceptions.py:95
#, python-brace-format
msgid ""
"Invalid sort criteria '{criteria}'. Choose from: name, version, time, "
"mtime, ctime, size, none."
msgstr ""
"Ungültiges Sortierkriterium '{criteria}'. Auswahl aus: name, version, "
"time, mtime, ctime, size, none."

#: src/findfmt/exceptions.py:116
#, python-brace-format
msgid "{field} must be non-negative, got {value}"
msgstr "{field} muss nicht-negativ sein, erhalten: {value}"

#: src/findfmt/exceptions.py:123
#, python-brace-format
msgid "{field} exceeds platform limit"
msgstr "{field} überschreitet das Plattformlimit"

#: src/findfmt/exceptions.py:130
#, python-brace-format
msgid "Invalid glob pattern: '{pattern}'"
msgstr "Ungültiges Glob-Muster: '{pattern}'"

