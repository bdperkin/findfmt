#: src/findfmt/diagnostics.py:87
msgid "not installed"
msgstr "non installé"

#: src/findfmt/diagnostics.py:92
msgid "not found"
msgstr "non trouvé"

#: src/findfmt/diagnostics.py:101
msgid "none"
msgstr "aucune"

#: src/findfmt/entrypoints.py:196
msgid ""
"Find all files and directories, including hidden files respecting "
".gitignore."
msgstr ""
"Rechercher tous les fichiers et répertoires, y compris les fichiers cachés "
"en respectant .gitignore."

#: src/findfmt/entrypoints.py:215
msgid ""
"Find files and list detected format and MIME tags, including hidden files"
" respecting .gitignore."
msgstr ""
"Rechercher des fichiers et lister les balises de format et MIME détectées, "
"y compris les fichiers cachés en respectant .gitignore."

#: src/findfmt/entrypoints.py:244
msgid ""
"Find files by format tag, including hidden files respecting .gitignore.\n"
"\n"
"Optionally provide TAG as the first positional argument (e.g. "
"'findfilefmt python')."
msgstr ""
"Rechercher des fichiers par balise de format, y compris les fichiers cachés "
"en respectant .gitignore.\n"
"\n"
"Fournir éventuellement TAG comme premier argument positionnel (p. ex. "
"'findfilefmt python')."

#: src/findfmt/entrypoints.py:273
msgid ""
"Find files by shebang interpreter pattern, including hidden files "
"respecting .gitignore.\n"
"\n"
"Optionally provide INTERPRETER as the first positional argument (e.g. "
"'findshebang bash')."
msgstr ""
"Rechercher des fichiers par motif d'interpréteur shebang, y compris les "
"fichiers cachés en respectant .gitignore.\n"
"\n"
"Fournir éventuellement INTERPRETER comme premier argument positionnel "
"(p. ex. 'findshebang bash')."

#: src/findfmt/entrypoints.py:295
msgid ""
"Find files and output NUL-delimited paths (--print0), including hidden "
"files respecting .gitignore."
msgstr ""
"Rechercher des fichiers et afficher des chemins séparés par NUL (--print0), "
"y compris les fichiers cachés en respectant .gitignore."

#: src/findfmt/entrypoints.py:315
msgid ""
"Find files and print summary statistics to stderr, including hidden files"
" respecting .gitignore."
msgstr ""
"Rechercher des fichiers et afficher les statistiques récapitulatives sur "
"stderr, y compris les fichiers cachés en respectant .gitignore."

#: src/findfmt/exceptions.py:39
#, python-brace-format
msgid "Unsupported output format: '{format}'. Expected one of: {valid_formats}"
msgstr ""
"Format de sortie non pris en charge : '{format}'. Valeurs attendues : "
"{valid_formats}"

#: src/findfmt/exceptions.py:57
#, python-brace-format
msgid "Unsupported RST table style: '{style}'. Expected 'grid' or 'simple'."
msgstr ""
"Style de tableau RST non pris en charge : '{style}'. 'grid' ou 'simple' "
"attendu."

#: src/findfmt/exceptions.py:76
#, python-brace-format
msgid "Unsupported table style: '{style}'. Expected one of: {valid_styles}"
msgstr ""
"Style de tableau non pris en charge : '{style}'. Valeurs attendues : "
"{valid_styles}"

#: src/findfmt/exceptions.py:95
#, python-brace-format
msgid ""
"Invalid sort criteria '{criteria}'. Choose from: name, version, time, "
"mtime, ctime, size, none."
msgstr ""
"Critère de tri invalide '{criteria}'. Choisissez parmi : name, version, "
"time, mtime, ctime, size, none."

