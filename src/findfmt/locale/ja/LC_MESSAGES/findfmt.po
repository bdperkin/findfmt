#: src/findfmt/cli/config_schema.py:216
#, python-brace-format
msgid "expected string or list of strings, got {type_name}"
msgstr "文字列または文字列のリストが必要ですが、{type_name} が指定されました"

#: src/findfmt/cli/config_schema.py:233
#, python-brace-format
msgid "expected non-negative integer, got {val}"
msgstr "非負整数が必要ですが、{val} が指定されました"

#: src/findfmt/cli/config_schema.py:250
#, python-brace-format
msgid "expected string, got {type_name}"
msgstr "文字列が必要ですが、{type_name} が指定されました"

#: src/findfmt/cli/config_schema.py:303
#, python-brace-format
msgid "Error: Unknown configuration key '{key}' in '{path}'."
msgstr "エラー: '{path}' 内に不明な設定キー '{key}' があります。"

