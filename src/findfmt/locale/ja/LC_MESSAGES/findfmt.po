#: src/findfmt/cli/config_schema.py:177
#, python-brace-format
msgid "expected 'auto', 'always', 'never', or boolean, got '{val}'"
msgstr "'auto'、'always'、'never'、または真偽値が必要ですが、'{val}' が指定されました"

#: src/findfmt/cli/config_schema.py:192
#, python-brace-format
msgid "expected boolean (true/false), got {type_name}"
