#: src/findfmt/exceptions.py:39
#, python-brace-format
msgid "Unsupported output format: '{format}'. Expected one of: {valid_formats}"
msgstr ""
"サポートされていない出力形式です: '{format}'。有効な形式: {valid_formats}"

#: src/findfmt/exceptions.py:57
#, python-brace-format
msgid "Unsupported RST table style: '{style}'. Expected 'grid' or 'simple'."
msgstr ""
"サポートされていない RST テーブルスタイルです: '{style}'。'grid' または "
"'simple' を指定してください。"

#: src/findfmt/exceptions.py:76
#, python-brace-format
msgid "Unsupported table style: '{style}'. Expected one of: {valid_styles}"
msgstr ""
"サポートされていないテーブルスタイルです: '{style}'。有効なスタイル: "
"{valid_styles}"

#: src/findfmt/exceptions.py:95
#, python-brace-format
msgid ""
"Invalid sort criteria '{criteria}'. Choose from: name, version, time, mtime, "
"ctime, size, none."
msgstr ""
"無効なソート基準です '{criteria}'。次から選択してください: name, version, "
"time, mtime, ctime, size, none。"

