msgstr "エラー: 出力形式オプションが競合しています: {options}。"

#: src/findfmt/cli/config.py:98
#, python-brace-format
msgid "Error: Input file '{path}' not found."
msgstr "エラー: 入力ファイル '{path}' が見つかりません。"

#: src/findfmt/cli/config.py:105
msgid "Error: Cannot specify both --dirsfirst and --filesfirst."
msgstr "エラー: --dirsfirst と --filesfirst を同時に指定することはできません。"

#: src/findfmt/cli/config_schema.py:155
#, python-brace-format
msgid "expected string format name, got {type_name}"
msgstr "文字列のフォーマット名が必要ですが、{type_name} が指定されました"

#: src/findfmt/cli/config_schema.py:159 src/findfmt/cli/config_schema.py:179
#: src/findfmt/cli/config_schema.py:212 src/findfmt/cli/config_schema.py:229
#: src/findfmt/cli/config_schema.py:253 src/findfmt/cli/config_schema.py:268
