msgstr ""
"Establecer explícitamente la configuración regional para traducciones y "
"visualización (p. ej. 'en_US', 'es', 'C')."

#: src/findfmt/cli/help.py:238
msgid "Comprehensive CLI Reference"
msgstr "Referencia completa de la CLI"

#: src/findfmt/cli/help.py:240
msgid ""
"Usage: findfmt [OPTIONS] [paths]...\n"
"\n"
"Tag Filtering:\n"
"  --type, -t, --tag <str>       Tag or comma-separated tags to match.\n"
"  --exclude, -e, --exclude-tag  Tag or comma-separated tags to exclude.\n"
"  --all-tags / --no-all-tags    Require matching ALL specified tags\n"
"                                [default: no-all-tags].\n"
"\n"
"Traversal Controls:\n"
"  --pattern, -P <pattern>       Include files matching wildcard or glob "
"pattern.\n"
"  --exclude-pattern, -I <pat>   Exclude files matching wildcard or glob "
"pattern.\n"
"  --ignore-case                 Case-insensitive pattern matching across "
"-P and -I.\n"
"  --match-dirs, --matchdirs     Match directory names; matched dirs "
"inherit to children.\n"
"  --shebang <str>               Filter files by shebang pattern.\n"
"  --dirs-only, -d               List directories only, suppressing "
"regular files.\n"
"  --max-depth, -L <level>       Restrict descent to maximum depth level.\n"
"  --follow-links, --follow-symlinks, -l\n"
"                                Follow directory symlinks with loop "
"detection.\n"
"  --symlinks / --no-symlinks    Alias for --follow-links / --no-follow-"
"links.\n"
"  --one-file-system, -x         Confine traversal to root filesystem "
"device.\n"
"  --filelimit <limit>           Skip directories exceeding entry count "
"threshold.\n"
"  --prune                       Omit directories containing zero matching"
" files.\n"
"  --no-ignore / --ignore        Do not respect .gitignore rules [default:"
" ignore].\n"
"  --gitignore-file <path>       Apply custom ignore file across traversal"
" scope.\n"
"  --from-file, --fromfile <p>   Read paths from file or standard input "
"('-').\n"
"  --offline                     Enforce offline filename identification.\n"
"  --all, --hidden, -a           Include hidden files and dirs [default: "
"no-hidden].\n"
"  --sort <criteria>             Sort files (name, version, time, ctime, "
"size, none)\n"
"                                [default: name].\n"
"  --reverse, -r                 Invert active sort order.\n"
"  --unsorted, -U                Raw directory order without sorting.\n"
"  --dirsfirst                   List directories before files within "
"directory levels.\n"
"  --filesfirst                  List files before directories within "
"directory levels.\n"
"\n"
"Output Formatting:\n"
"  --format, -f <fmt>            Output format (text, json, jsonl, yaml, "
"ipynb,\n"
"                                csv, csv-table, tsv, markdown, rst, "
"table, tree,\n"
"                                xml, html) [default: text].\n"
"  --json, -J / --no-json        Output structured JSON representation.\n"
"  --xml, -X / --no-xml          Output directory tree as an XML document."
"\n"
"  --html, -H <baseHREF>         Output directory tree as an HTML "
"document.\n"
"  --intro <path>                Prepend custom HTML fragment before "
"listing.\n"
"  --outro <path>                Append custom HTML fragment after "
"listing.\n"
"  --title, -T <title>           Set title and <h1> heading for HTML "
"output.\n"
"  --nolinks / --no-nolinks      Suppress hyperlink anchors in HTML "
"output.\n"
"  --hyperlink / --no-hyperlink  Wrap paths in OSC 8 terminal hyperlinks.\n"
"  --hyperlink-schema <schema>   URI schema prefix (default: file://).\n"
"  --hyperlink-authority <auth>  URI authority override (e.g. localhost).\n"
"  --output, -o <path>           Send command output directly to a file.\n"
"  --csv-safe / --no-csv-safe    Neutralize spreadsheet formulas in "
"CSV/TSV cells.\n"
"  --tree / --no-tree            Render output in hierarchical tree view.\n"
"  --table-style <style>         Border style (rounded, cp437, ascii, "
"etc.).\n"
"  --pager / --no-pager          Enable or disable interactive paging.\n"
"  --no-indent, -i / --indent    Omit indentation lines and strip "
"extraneous whitespace.\n"
"  --ansi-lines, -A              Use ANSI/VT100 line drawing escapes.\n"
"  --cp437, -S                   Use CP437 console graphics line drawing "
"characters.\n"
"  --color, -C / --no-color, -n  Force enable or disable ANSI color "
"output.\n"
"  --absolute, --full-path       Output absolute paths rather than "
"relative paths.\n"
"  --relative, --relative-path   Prepend input search path prefix to "
"relative paths.\n"
"  --permissions, -p             Format file mode in standard ls -l style."
"\n"
"  --user, -u                    Display file owner username (falling back"
" to UID).\n"
"  --group, -g                   Display file owner group (falling back to"
" GID).\n"
"  --inodes                      Print filesystem inode number (st_ino).\n"
"  --device                      Print filesystem device number (st_dev).\n"
"  --size / --no-size            Print file size in bytes.\n"
"  --human-readable, -h          Print sizes in human-readable binary "
"format.\n"
"  --si / --no-si                Print sizes in human-readable SI metric "
"format.\n"
"  --du, --accumulate-size       Accumulate recursive directory disk "
"usage.\n"
"  --mtime, -D                   Display last modification time.\n"
"  --ctime                       Display last status change time.\n"
"  --time-format, --timefmt <f>  Date and time format string (strftime "
"syntax).\n"
"  --classify, -F                Append indicator (/ @ * = | >) to "
"filenames.\n"
"  --hide-control-chars, -q      Mask non-printable control characters "
"with '?'.\n"
"  --literal, -N                 Print non-printable characters literally."
"\n"
"  --quote-name, -Q              Enclose filenames in double quotes.\n"
"  --print0, -0 / --no-print0    Delimit with NUL (\\0) byte [default: no-"
"print0].\n"
"  --list-tags / --no-list-tags  Display identified tags [default: no-"
"list-tags].\n"
"  --summary, -s / --no-summary  Print summary statistics [default: no-"
"summary].\n"
"  --exit-status                 Exit with code 1 if no matching files are"
" found.\n"
"\n"
"Help & Diagnostics:\n"
"  --config <path>               Path to custom configuration file "
"overriding defaults.\n"
"  --no-config                   Suppress loading any configuration file.\n"
"  --show-config                 Display resolved configuration settings "
"and exit.\n"
"  --known-tags                  List all known classification tags and "
"exit.\n"
"  --locale, --lang <locale>     Set display locale (e.g. 'en_US', 'es', "
"'C').\n"
"  --version, -v, -V             Display version (use with --verbose for "
"diagnostics).\n"
"  --verbose                     Include extended runtime diagnostics with"
" --version.\n"
"  --diagnostics                 Display runtime environment diagnostics "
"and exit.\n"
"  --help-all                    Display this comprehensive reference and "
"exit.\n"
"  --help                        Display categorized help summary and "
"exit.\n"
"\n"
"Command Wrappers:\n"
"  findfiles [PATHS...]          Equivalent to findfmt --hidden\n"
"  findfilemime [PATHS...]       Equivalent to findfmt --hidden --list-"
"tags\n"
"  findfilefmt [TAG] [PATHS...]  Equivalent to findfmt --hidden --tag TAG\n"
"  findshebang [INTERP]...       Equivalent to findfmt --hidden --shebang "
"INTERPRETER\n"
"  findfmt0 [PATHS...]           Equivalent to findfmt --hidden --print0\n"
"  findsummary [PATHS...]        Equivalent to findfmt --hidden --summary\n"
"\n"
"POSIX Double-Dash (--) Terminator:\n"
"  Arguments following '--' are treated strictly as positional paths:\n"
"  $ findfmt -- -hyphen-dir/\n"
"  $ findfilefmt python -- -weird-name/\n"
"\n"
"Environment Variables:\n"
"  NO_COLOR                      When set, suppresses colored output "
"(https://no-color.org).\n"
"  CLICOLOR                      When set to 0, suppresses ANSI colors; 1 "
"enables colors.\n"
"  CLICOLOR_FORCE                When non-zero, forces color output even "
"when piped.\n"
"  FINDFMT_CONFIG                Path to custom configuration file "
"overriding defaults.\n"
"\n"
"Exit Codes:\n"
"  0                             Success, even when no files match (see "
"--exit-status).\n"
"  1                             Runtime error, or no matches with --exit-"
"status.\n"
"  2                             Invalid command-line usage, options, or "
"config file.\n"
"  130                           Interrupted by SIGINT (Ctrl+C).\n"
"\n"
"Workflow Examples:\n"
"  $ findfmt -t python                     # Find Python files in current "
"repository\n"
"  $ findfmt --shebang bash scripts/       # Find bash scripts in scripts/"
"\n"
"  $ findfmt -t python -t executable --all-tags  # Require BOTH tags\n"
"  $ findfiles --no-hidden                 # Traverse files without hidden"
" files\n"
"  $ findfilefmt json                      # Shortcut: find JSON files\n"
"  $ findshebang python                    # Shortcut: find Python shebang"
" scripts\n"
"  $ findfmt0 -t python | xargs -0 flake8  # Pipe NUL-delimited paths "
"safely\n"
"  $ findsummary                           # Print summary match "
"statistics to stderr\n"
msgstr ""
"Uso: findfmt [OPTIONS] [paths]...\n"
"\n"
"Filtrado de etiquetas:\n"
"  --type, -t, --tag <str>       Etiqueta o etiquetas separadas por comas "
"para coincidir.\n"
"  --exclude, -e, --exclude-tag  Etiqueta o etiquetas separadas por comas "
"para excluir.\n"
"  --all-tags / --no-all-tags    Requerir coincidencia con TODAS las "
"etiquetas\n"
"                                [default: no-all-tags].\n"
"\n"
"Controles de recorrido:\n"
"  --pattern, -P <pattern>       Incluir archivos que coincidan con patrón"
" comodín o glob.\n"
"  --exclude-pattern, -I <pat>   Excluir archivos que coincidan con patrón"
" comodín o glob.\n"
"  --ignore-case                 Coincidencia sin distinción de "
"mayúsculas/minúsculas en -P e -I.\n"
"  --match-dirs, --matchdirs     Coincidir nombres de directorios; se "
"hereda a los hijos.\n"
"  --shebang <str>               Filtrar archivos por patrón de shebang.\n"
"  --dirs-only, -d               Listar solo directorios, suprimiendo "
"archivos regulares.\n"
"  --max-depth, -L <level>       Restringir el descenso al nivel máximo de"
" profundidad.\n"
"  --follow-links, --follow-symlinks, -l\n"
"                                Seguir enlaces simbólicos con detección "
"de bucles.\n"
"  --symlinks / --no-symlinks    Alias de --follow-links / --no-follow-"
"links.\n"
"  --one-file-system, -x         Limitar el recorrido al dispositivo del "
"sistema de archivos raíz.\n"
"  --filelimit <limit>           Omitir directorios que superen el umbral "
"de entradas.\n"
"  --prune                       Omitir directorios sin archivos "
"coincidentes.\n"
"  --no-ignore / --ignore        No respetar reglas .gitignore [default: "
"ignore].\n"
"  --gitignore-file <path>       Aplicar archivo ignore personalizado en "
"el recorrido.\n"
"  --from-file, --fromfile <p>   Leer rutas desde archivo o entrada "
"estándar ('-').\n"
"  --offline                     Forzar identificación sin conexión por "
"nombre de archivo.\n"
"  --all, --hidden, -a           Incluir archivos y directorios ocultos "
"[default: no-hidden].\n"
"  --sort <criteria>             Ordenar archivos (name, version, time, "
"ctime, size, none)\n"
"                                [default: name].\n"
"  --reverse, -r                 Invertir el orden de clasificación "
"activo.\n"
"  --unsorted, -U                Orden bruto de directorio sin ordenar.\n"
"  --dirsfirst                   Listar directorios antes que archivos en "
"cada nivel.\n"
"  --filesfirst                  Listar archivos antes que directorios en "
"cada nivel.\n"
"\n"
"Formato de salida:\n"
"  --format, -f <fmt>            Formato de salida (text, json, jsonl, "
"yaml, ipynb,\n"
"                                csv, csv-table, tsv, markdown, rst, "
"table, tree,\n"
"                                xml, html) [default: text].\n"
"  --json, -J / --no-json        Emitir representación JSON estructurada.\n"
"  --xml, -X / --no-xml          Emitir árbol de directorios como "
"documento XML.\n"
"  --html, -H <baseHREF>         Emitir árbol de directorios como "
"documento HTML.\n"
"  --intro <path>                Anteponer fragmento HTML personalizado "
"antes del listado.\n"
"  --outro <path>                Añadir fragmento HTML personalizado "
"después del listado.\n"
"  --title, -T <title>           Establecer título y encabezado <h1> para "
"salida HTML.\n"
"  --nolinks / --no-nolinks      Suprimir hipervínculos en la salida HTML."
"\n"
"  --hyperlink / --no-hyperlink  Envolver rutas en hipervínculos de "
"terminal OSC 8.\n"
"  --hyperlink-schema <schema>   Prefijo de esquema URI (default: "
"file://).\n"
"  --hyperlink-authority <auth>  Autoridad URI personalizada (p. ej. "
"localhost).\n"
"  --output, -o <path>           Enviar la salida del comando directamente"
" a un archivo.\n"
"  --csv-safe / --no-csv-safe    Neutralizar fórmulas de hojas de cálculo "
"en CSV/TSV.\n"
"  --tree / --no-tree            Representar la salida en vista de árbol "
"jerárquico.\n"
"  --table-style <style>         Estilo de borde (rounded, cp437, ascii, "
"etc.).\n"
"  --pager / --no-pager          Habilitar o deshabilitar paginación "
"interactiva.\n"
"  --no-indent, -i / --indent    Omitir líneas de sangría y espacios "
"adicionales.\n"
"  --ansi-lines, -A              Usar secuencias de líneas ANSI/VT100.\n"
"  --cp437, -S                   Usar caracteres gráficos de consola "
"CP437.\n"
"  --color, -C / --no-color, -n  Forzar activación o desactivación de "
"color ANSI.\n"
"  --absolute, --full-path       Emitir rutas absolutas en lugar de rutas "
"relativas.\n"
"  --relative, --relative-path   Anteponer prefijo de búsqueda a rutas "
"relativas.\n"
"  --permissions, -p             Formatear permisos en estilo estándar ls "
"-l.\n"
"  --user, -u                    Mostrar usuario propietario (o UID como "
"respaldo).\n"
"  --group, -g                   Mostrar grupo propietario (o GID como "
"respaldo).\n"
"  --inodes                      Imprimir número de inodo del sistema de "
"archivos (st_ino).\n"
"  --device                      Imprimir número de dispositivo (st_dev).\n"
"  --size / --no-size            Imprimir tamaño de archivo en bytes.\n"
"  --human-readable, -h          Imprimir tamaños en formato binario "
"legible.\n"
"  --si / --no-si                Imprimir tamaños en formato métrico SI "
"legible.\n"
"  --du, --accumulate-size       Acumular uso de disco recursivo de "
"directorios.\n"
"  --mtime, -D                   Mostrar fecha de última modificación.\n"
"  --ctime                       Mostrar fecha de último cambio de estado."
"\n"
"  --time-format, --timefmt <f>  Cadena de formato de fecha y hora "
"(sintaxis strftime).\n"
"  --classify, -F                Añadir indicador (/ @ * = | >) a nombres "
"de archivo.\n"
"  --hide-control-chars, -q      Enmascarar caracteres de control no "
"imprimibles con '?'.\n"
"  --literal, -N                 Imprimir caracteres no imprimibles "
"literalmente.\n"
"  --quote-name, -Q              Encerrar nombres de archivo entre "
"comillas dobles.\n"
"  --print0, -0 / --no-print0    Delimitar con byte NUL (\\0) [default: "
"no-print0].\n"
"  --list-tags / --no-list-tags  Mostrar etiquetas identificadas [default:"
" no-list-tags].\n"
"  --summary, -s / --no-summary  Imprimir estadísticas de resumen "
"[default: no-summary].\n"
"  --exit-status                 Salir con código 1 si no hay archivos "
"coincidentes.\n"
"\n"
"Ayuda y diagnósticos:\n"
"  --config <path>               Ruta a archivo de configuración "
"personalizado.\n"
"  --no-config                   Suprimir la carga de cualquier archivo de"
" configuración.\n"
"  --show-config                 Mostrar la configuración resuelta y "
"salir.\n"
"  --known-tags                  Listar todas las etiquetas conocidas y "
"salir.\n"
"  --locale, --lang <locale>     Establecer idioma (p. ej. 'en_US', 'es', "
"'C').\n"
"  --version, -v, -V             Mostrar versión (usar con --verbose para "
"diagnósticos).\n"
"  --verbose                     Incluir diagnósticos extendidos con "
"--version.\n"
"  --diagnostics                 Mostrar diagnósticos del entorno y salir."
"\n"
"  --help-all                    Mostrar esta referencia completa y salir."
"\n"
"  --help                        Mostrar resumen de ayuda categorizado y "
"salir.\n"
"\n"
"Comandos envoltorio:\n"
"  findfiles [PATHS...]          Equivalente a findfmt --hidden\n"
"  findfilemime [PATHS...]       Equivalente a findfmt --hidden --list-"
"tags\n"
"  findfilefmt [TAG] [PATHS...]  Equivalente a findfmt --hidden --tag TAG\n"
"  findshebang [INTERP]...       Equivalente a findfmt --hidden --shebang "
"INTERPRETER\n"
"  findfmt0 [PATHS...]           Equivalente a findfmt --hidden --print0\n"
"  findsummary [PATHS...]        Equivalente a findfmt --hidden --summary\n"
"\n"
"Terminador POSIX de doble guion (--):\n"
"  Los argumentos posteriores a '--' se tratan estrictamente como rutas "
"posicionales:\n"
"  $ findfmt -- -hyphen-dir/\n"
"  $ findfilefmt python -- -weird-name/\n"
"\n"
"Variables de entorno:\n"
"  NO_COLOR                      Cuando se define, suprime la salida en "
"color (https://no-color.org).\n"
"  CLICOLOR                      0 suprime colores ANSI; 1 habilita "
"colores.\n"
"  CLICOLOR_FORCE                Distinto de cero fuerza salida en color "
"incluso en tuberías.\n"
"  FINDFMT_CONFIG                Ruta al archivo de configuración "
"personalizado.\n"
"\n"
"Códigos de salida:\n"
"  0                             Éxito, incluso cuando ningún archivo "
"coincide (véase --exit-status).\n"
"  1                             Error de ejecución, o sin coincidencias "
"con --exit-status.\n"
"  2                             Uso inválido de línea de comandos, "
"opciones o configuración.\n"
"  130                           Interrumpido por SIGINT (Ctrl+C).\n"
"\n"
"Ejemplos de flujo de trabajo:\n"
"  $ findfmt -t python                     # Buscar archivos Python en el "
"repositorio actual\n"
"  $ findfmt --shebang bash scripts/       # Buscar scripts bash en "
"scripts/\n"
"  $ findfmt -t python -t executable --all-tags  # Requerir AMBAS "
"etiquetas\n"
"  $ findfiles --no-hidden                 # Recorrer archivos sin "
"archivos ocultos\n"
"  $ findfilefmt json                      # Atajo: buscar archivos JSON\n"
"  $ findshebang python                    # Atajo: buscar scripts con "
"shebang Python\n"
"  $ findfmt0 -t python | xargs -0 flake8  # Canalizar rutas delimitadas "
"por NUL de forma segura\n"
"  $ findsummary                           # Imprimir estadísticas de "
"resumen en stderr\n"

