#~ "Usage: findfmt [OPTIONS] [paths]...\n"
#~ "\n"
#~ "Tag Filtering:\n"
#~ "  --type, -t, --tag <str>       Tag or comma-separated tags to match.\n"
#~ "  --exclude, -e, --exclude-tag  Tag "
#~ "or comma-separated tags to exclude.\n"
#~ ""
#~ "  --all-tags / --no-all-tags    Require matching ALL specified tags\n"
#~ "                                [default: no-all-tags].\n"
#~ "\n"
#~ "Traversal Controls:\n"
#~ "  --pattern, -P <pattern>       Include "
#~ "files matching wildcard or glob pattern."
#~ "\n"
#~ "  --exclude-pattern, -I <pat>   Exclude"
#~ " files matching wildcard or glob "
#~ "pattern.\n"
#~ "  --ignore-case                 Case-"
#~ "insensitive pattern matching across -P "
#~ "and -I.\n"
#~ "  --match-dirs, --matchdirs     Match "
#~ "directory names; matched dirs inherit to"
#~ " children.\n"
#~ "  --shebang <str>               Filter files by shebang pattern.\n"
#~ "  --dirs-only, -d               List "
#~ "directories only, suppressing regular files."
#~ "\n"
#~ "  --max-depth, -L <level>       Restrict"
#~ " descent to maximum depth level.\n"
#~ "  --follow-links, --follow-symlinks, -l\n"
#~ "                                Follow directory "
#~ "symlinks with loop detection.\n"
#~ "  --symlinks / --no-symlinks    Alias"
#~ " for --follow-links / --no-follow-"
#~ "links.\n"
#~ "  --one-file-system, -x         Confine"
#~ " traversal to root filesystem device.\n"
#~ ""
#~ "  --filelimit <limit>           Skip "
#~ "directories exceeding entry count threshold."
#~ "\n"
#~ "  --prune                       Omit directories "
#~ "containing zero matching files.\n"
#~ "  --no-ignore / --ignore        Do "
