#: src/findfmt/exceptions.py:39
#, python-brace-format
msgid "Unsupported output format: '{format}'. Expected one of: {valid_formats}"
msgstr ""
"¡Formato de salida no soportado: '{format}'! Se esperaba uno de: "
"{valid_formats}"

#: src/findfmt/exceptions.py:57
#, python-brace-format
msgid "Unsupported RST table style: '{style}'. Expected 'grid' or 'simple'."
msgstr ""
"¡Estilo de tabla RST no soportado: '{style}'! Se esperaba 'grid' o "
"'simple'."

#: src/findfmt/exceptions.py:76
#, python-brace-format
msgid "Unsupported table style: '{style}'. Expected one of: {valid_styles}"
msgstr ""
"¡Estilo de tabla no soportado: '{style}'! Se esperaba uno de: "
"{valid_styles}"

#: src/findfmt/exceptions.py:95
#, python-brace-format
msgid ""
"Invalid sort criteria '{criteria}'. Choose from: name, version, time, "
"mtime, ctime, size, none."
msgstr ""
"¡Criterio de ordenación inválido '{criteria}'! Elija entre: name, "
"version, time, mtime, ctime, size, none."

