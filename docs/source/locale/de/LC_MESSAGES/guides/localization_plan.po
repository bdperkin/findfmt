msgstr ""

#: ../../source/guides/localization_plan.md:316
#: aa75be7c36c344c3b1313ab3bb5e3cb4
msgid "7.2. Step 2: Configure the Plural-Forms Header"
msgstr ""

#: ../../source/guides/localization_plan.md:318
#: 39ca8c45da0d4140ad3504eeb8a62f45
msgid ""
"Edit `src/findfmt/locale/<locale>/LC_MESSAGES/findfmt.po` and set the "
"`Plural-Forms` header according to gettext standards:"
msgstr ""

#: ../../source/guides/localization_plan.md:321
#: f634b0d154cd4752aada142e63399dce
msgid ""
"**Single Form (`nplurals=1; plural=0;`)**: Applicable to Chinese "
"(`zh_CN`, `zh_TW`), Japanese (`ja`), Korean (`ko`), Indonesian (`id`), "
"Malay (`ms`), Vietnamese (`vi`), Thai (`th`), Lao (`lo`), Burmese (`my`),"
" Khmer (`km`), N'Ko (`nqo`)."
msgstr ""

#: ../../source/guides/localization_plan.md:324
#: 523b12f50c2d47f58196915871bf365a
msgid ""
"**Two Forms (`nplurals=2; plural=(n != 1);`)**: Applicable to English "
