msgid ""
"This document establishes the architecture, linguistic metadata, phased "
"roadmap, and contribution workflow for internationalization (i18n) and "
"localization (l10n) across `findfmt`."
msgstr ""

#: ../../source/guides/localization_plan.md:7 56ddbf8ac9574101923cab102bdc3382
