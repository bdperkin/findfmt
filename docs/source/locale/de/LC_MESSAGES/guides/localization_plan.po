#: ../../source/guides/localization_plan.md:297
#: 799211f2debe4339b3aad4666a53c737
msgid ""
"Follow these steps when implementing support for a target locale "
"`<locale>`:"
msgstr ""

#: ../../source/guides/localization_plan.md:299
#: b9098502bb1d4150b22c49a59282904d
