#: ../../source/guides/localization_plan.md:293
#: d3cfcd68d83b447c8fcccc70c418697d
msgid ""
"Follow these steps when implementing support for a target locale "
"`<locale>`:"
msgstr ""

#: ../../source/guides/localization_plan.md:295
#: 2fda8701e2544e1584acf9e7eb5b50c7
msgid "7.1. Step 1: Initialize or Update Message Catalog"
msgstr ""

#: ../../source/guides/localization_plan.md:297
#: 34fe1a4b7aa9464d92bfa8d9e1a2749d
msgid "Extract translatable strings and initialize the catalog:"
msgstr ""

#: ../../source/guides/localization_plan.md:310
#: aeaf7cf5eb7e4a8bb1105044468f8499
msgid ""
"The catalog is created or updated at: "
"`src/findfmt/locale/<locale>/LC_MESSAGES/findfmt.po`"
msgstr ""

#: ../../source/guides/localization_plan.md:312
#: f8a61bf5468b40e19c135c19f419e03d
msgid "7.2. Step 2: Configure the Plural-Forms Header"
msgstr ""

#: ../../source/guides/localization_plan.md:314
#: 084bce73a76b4b25a960bc5e457d91db
msgid ""
"Edit `src/findfmt/locale/<locale>/LC_MESSAGES/findfmt.po` and set the "
"`Plural-Forms` header according to gettext standards:"
msgstr ""

#: ../../source/guides/localization_plan.md:317
#: 0222845b615842c28562c1b4f48ebf32
msgid ""
"**Single Form (`nplurals=1; plural=0;`)**: Applicable to Chinese "
"(`zh_CN`, `zh_TW`), Japanese (`ja`), Korean (`ko`), Indonesian (`id`), "
"Malay (`ms`), Vietnamese (`vi`), Thai (`th`), Lao (`lo`), Burmese (`my`),"
" Khmer (`km`), N'Ko (`nqo`)."
msgstr ""

#: ../../source/guides/localization_plan.md:320
#: f1aa9eb45e7049779ea68a93cde6b8c9
msgid ""
"**Two Forms (`nplurals=2; plural=(n != 1);`)**: Applicable to English "
"(`en`, `en_GB`), German (`de`), Spanish (`es`), Italian (`it`), Catalan "
"(`ca`), Dutch (`nl`), Swedish (`sv`), Greek (`el`), Hindi (`hi`), Bengali"
" (`bn`), Urdu (`ur`), Punjabi (`pa`), Marathi (`mr`), Gujarati (`gu`), "
"Odia (`or`), Telugu (`te`), Tamil (`ta`), Kannada (`kn`), Malayalam "
"(`ml`), Zulu (`zu`), Hungarian (`hu`)."
msgstr ""

#: ../../source/guides/localization_plan.md:325
