#: ../../source/cli/index.md:1 4053809deb5e4d1782b206b976597a0d
msgid "CLI Reference"
msgstr ""

#: ../../source/cli/index.md:3 0160fd14c2534e0e949a978911d9e04f
msgid ""
"`findfmt` provides a Unix-style command-line interface with options for "
"tagging, filtering, and output formatting."
msgstr ""

#: ../../source/cli/index.md:6 e3a35f1a63204ec2b06c5d24d2be6464
msgid "1. Synopsis"
msgstr ""

#: ../../source/cli/index.md:13 81cfc83c9cd141ec88832af66b0c0d6f
msgid "2. Description"
msgstr ""

#: ../../source/cli/index.md:15 765ae9a935404683b0146e0a7aee8e9d
msgid ""
"`findfmt` is a high-performance, `.gitignore`-aware file discovery and "
"classification suite. It locates files by content format, shebang, and "
"MIME tag rather than relying strictly on file extensions, producing "
"clean, sorted relative paths ready for Unix pipelines and interactive "
"terminal review."
msgstr ""

#: ../../source/cli/index.md:20 e67652e2617f4fdb9c5f19753fd62635
msgid "3. Options"
msgstr ""

#: ../../source/cli/index.md:22 a5165eccd8944cb78136c5806fdfcfb4
msgid "3.1. Tag Filtering"
msgstr ""

#: ../../source/cli/index.md:24 8872b6fde8e1487eb571d0e515f1ca4a
msgid ""
"`-t, --type, --tag TAG` : Filter files by tag (e.g. `python`, `yaml`, "
"`json`, `shell`, `executable`). Can be specified multiple times or comma-"
"separated (`-t python,shell`)."
msgstr ""

#: ../../source/cli/index.md:27 bd7aaa244ba94a91b96a6a1a529eeb76
msgid "`-e, --exclude, --exclude-tag TAG` : Exclude files matching this tag."
msgstr ""

#: ../../source/cli/index.md:29 a711480b800e4d868c02fd35059a6d58
msgid ""
"`--all-tags / --no-all-tags` : Require matching files to contain **all** "
"specified include tags rather than at least one (`--no-all-tags` disables"
" this requirement)."
msgstr ""

#: ../../source/cli/index.md:32 f2801fb7b8f44d678e85a7bdb1ad2e15
msgid ""
"`--shebang INTERPRETER` : Filter files whose shebang line contains the "
"specified interpreter name or substring."
msgstr ""

#: ../../source/cli/index.md:35 62c6a235fd624f96be15482f42ba96cd
msgid "3.2. Traversal Controls"
msgstr ""

#: ../../source/cli/index.md:37 10f47d9791564c5ab3ac23238570248d
msgid ""
"`-d, --dirs-only` : List directories only, suppressing regular file "
"entries."
msgstr ""

#: ../../source/cli/index.md:39 0850a9bb60a8404c86b55397e9c1cbe4
msgid ""
"`-l, --follow-links, --follow-symlinks / --no-follow-links, --no-follow-"
"symlinks` (alias: `--symlinks / --no-symlinks`) : Follow directory "
"symlinks with cycle and loop detection."
msgstr ""

#: ../../source/cli/index.md:42 524e2571a76e4310a75d0b89879af8c8
msgid ""
"`-x, --one-file-system` : Confine traversal to the filesystem device of "
"the starting directory."
msgstr ""

#: ../../source/cli/index.md:44 17efd32f25024502b1a766ad45c8fcff
msgid ""
"`-L, --max-depth LEVEL` : Restrict directory traversal descent to a "
"maximum depth level."
msgstr ""

#: ../../source/cli/index.md:46 85df2754d0cb48e687375fcbc21267e9
msgid ""
"`--filelimit LIMIT` : Skip directories whose immediate child entry count "
"exceeds this threshold."
msgstr ""

#: ../../source/cli/index.md:48 a7df19db9817450ea49e9f13f9a68b6f
msgid ""
"`--prune` : Omit empty directories and directories containing zero "
"matching files from output."
msgstr ""

#: ../../source/cli/index.md:50 843038cb0ef1424086c59f2e8f3d1aa4
msgid ""
"`-P, --pattern, --include-pattern PATTERN` : List only files matching the"
" wildcard or glob expression. Supports multiple `-P` flags and `|` "
"alternation (e.g. `*.py|*.md`)."
msgstr ""

#: ../../source/cli/index.md:53 e41e992180c44fdbb47cef7ccdfe8978
msgid ""
"`-I, --exclude-pattern PATTERN` : Omit files and directories matching the"
" wildcard or glob expression. Supports multiple `-I` flags and `|` "
"alternation (e.g. `*.tmp|*.bak`)."
msgstr ""

#: ../../source/cli/index.md:56 fe3ca07fa9bb4ce8b2b3bf28d51d604d
msgid ""
"`--ignore-case / --no-ignore-case` : Apply case-insensitive matching "
"across `-P` and `-I` patterns."
msgstr ""

#: ../../source/cli/index.md:58 c46c6633114046acb926225be83421b1
msgid ""
"`--match-dirs, --matchdirs / --no-match-dirs, --no-matchdirs` : Match "
"directory names against patterns. If a directory matches, pattern "
"restrictions are disabled for its children."
msgstr ""

#: ../../source/cli/index.md:61 1e4f54277c2041edb5c2e8888b34d599
msgid ""
"`--gitignore-file PATH` : Apply a specific external ignore file across "
"the traversal scope."
msgstr ""

#: ../../source/cli/index.md:63 ee2ea71ea45b448ea4772c3d3c6bc00e
msgid ""
"`--from-file, --fromfile PATH` : Ingest directory listings and path "
"structures from an external file or standard input (`-`) instead of "
"scanning the local filesystem. Supports both flat newline-delimited paths"
" (e.g. from `find` or `git ls-files`) and tab- or space-indented outlines"
" with automatic hierarchy and symlink (`link -> target`) detection."
msgstr ""

#: ../../source/cli/index.md:68 6e844aae7d57452c9c1dac5e40c694bb
msgid ""
"`--offline` : Enforce offline classification without inspecting the local"
" filesystem. Identifies file formats and types strictly via extension and"
" filename heuristics, operating gracefully when analyzing remote "
"manifests or containers without raising filesystem IO errors."
msgstr ""

#: ../../source/cli/index.md:72 6eaa38aa33c94d82a3fe6753b82839fd
msgid ""
"`--no-ignore / --ignore` : Do not prune paths matching `.gitignore` or "
"`.git/info/exclude`. Use `--ignore` to restore `.gitignore` honoring."
msgstr ""

#: ../../source/cli/index.md:75 89f642eb0fc84757a7de4069acc1920a
msgid ""
"`-a, --all / --no-all` (alias: `--hidden / --no-hidden`) : Traverse "
"hidden files and directories (names starting with `.`). Use `--no-all` or"
" `--no-hidden` to exclude hidden paths."
msgstr ""

#: ../../source/cli/index.md:78 283ec601c9f249fb8da1a7594c909cb2
msgid ""
"`--sort CRITERIA` : Sort entries by criteria: `name` (default), `version`"
" (natural numbers), `time` (or `mtime`, newest first), `ctime` (status "
"change, newest first), `size` (largest first), or `none` (unsorted)."
msgstr ""

#: ../../source/cli/index.md:82 f30888e905694bd6a9fedc3d30ea24f2
msgid ""
"`-r, --reverse` : Invert active sort order (e.g. oldest first for time, "
"smallest first for size, reverse alphabetical for name)."
msgstr ""

#: ../../source/cli/index.md:85 17463ae910a94877bed3cb1c7a66b24e
msgid ""
"`-U, --unsorted` : Do not sort entries; yield files in raw filesystem "
"order (equivalent to `--sort=none`). Bypasses sorting overhead and memory"
" buffering for massive trees."
msgstr ""

#: ../../source/cli/index.md:88 c7e7adf4cbf24208a761ac2d137bd740
msgid ""
"`--dirsfirst, --group-directories-first` : Group all directories before "
"files within each directory level, sorting each group by active criteria."
msgstr ""

#: ../../source/cli/index.md:91 41676bdd13d94ad3a28cce6fc5b67c84
msgid ""
"`--filesfirst` : Group all regular files before directories within each "
"directory level."
msgstr ""

#: ../../source/cli/index.md:93 6a4764ee4fef4a9ba7b3c3b270f33792
msgid "3.3. Output Controls"
msgstr ""

#: ../../source/cli/index.md:95 b407f787568d4a30bcd9d0587970d494
msgid ""
"`-f, --format FORMAT` : Choose the output serialization format (`text`, "
"`json`, `jsonl`, `yaml`, `ipynb`, `csv`, `csv-table`, `tsv`, `markdown`, "
"`rst`, `table`, `tree`, `xml`, `html`). Defaults to `text`."
msgstr ""

#: ../../source/cli/index.md:99 7e2659b1b41c489cb834b1892e1c35e5
msgid "`text`: Standard line-oriented or NUL-delimited plain text paths."
msgstr ""

#: ../../source/cli/index.md:101 7ecddc8b609746ee8ea8f84feefa53cb
msgid ""
"`json`: Deterministic JSON array of file objects with full metadata "
"attributes."
msgstr ""

#: ../../source/cli/index.md:103 51c7092ff3ce44b18b88d12944adc7de
msgid "`jsonl`: Line-delimited JSON (NDJSON) records for streaming pipelines."
msgstr ""

#: ../../source/cli/index.md:105 067160cddcc84ef58a011f7fdf27997c
msgid "`ndjson`: Alias for `jsonl` line-delimited JSON stream."
msgstr ""

#: ../../source/cli/index.md:107 d167b155f3674806b35036277ee529af
msgid "`yaml`: Clean, readable block-style YAML document."
msgstr ""

#: ../../source/cli/index.md:109 ca7aae0c06084b209020f2810b4adf9d
msgid ""
"`ipynb`: Jupyter Notebook (`.ipynb`) format pre-populated with data "
"analysis code cells."
msgstr ""

#: ../../source/cli/index.md:111 bddcacc489334c798dd2f6050d9749f4
msgid ""
"`csv`: RFC 4180 compliant comma-separated values with header row. When "
"consuming CSV in spreadsheet applications, consider passing `--csv-safe` "
"to neutralize spreadsheet formula injection risks."
msgstr ""

#: ../../source/cli/index.md:115 1e4441e68f1b4b158dbcb576436bf01f
msgid ""
"`csv-table`: Aligned ASCII or Unicode table constructed directly from CSV"
" schema for terminal review."
msgstr ""

#: ../../source/cli/index.md:118 13ff002b2e0d4ea0afdb0103c800f523
msgid ""
"`tsv`: Tab-separated values optimized for Unix shell pipelines (`awk`, "
"`cut`). Pass `--csv-safe` to neutralize formula injection triggers if "
"importing into spreadsheets."
msgstr ""

#: ../../source/cli/index.md:121 9928ab08fd214c64a6588ae181d9c543
msgid ""
"`markdown` (or `md`): GitHub Flavored Markdown (GFM) column-aligned table"
" with alignment indicators."
msgstr ""

#: ../../source/cli/index.md:124 b3e9a64ad2744fe18a17dbf078010ac0
msgid ""
"`rst`: reStructuredText grid or simple table format compatible with "
"Sphinx `.. include::` directives."
msgstr ""

#: ../../source/cli/index.md:127 6aa7d10a266d4264b26ea1ac4a752296
msgid ""
"`table`: Rich styled terminal table with colorful badges for tags, sizes,"
" and MIME types."
msgstr ""

#: ../../source/cli/index.md:129 0770ea4b5f5c480b915475a9c7dbc9a6
msgid ""
"`tree`: Hierarchical directory tree rendering files within their "
"directory branches."
msgstr ""

#: ../../source/cli/index.md:131 9066bf7488f8408f8f1a8e88f0046219
msgid ""
"`xml`: Well-formed hierarchical XML document capturing directories, "
"files, tags, and metadata attributes."
msgstr ""

#: ../../source/cli/index.md:134 f440dd9bf78544458660cfa2f01653ff
msgid ""
"`html`: Semantic, accessible HTML5 document with styled directory tree "
"and hyperlinks."
msgstr ""

#: ../../source/cli/index.md:136 ef48637dd2df4ca5a10ecac9c1ac94ff
msgid ""
"`--tree / --no-tree` : Render output in a hierarchical directory tree "
"(equivalent to `--format tree`)."
msgstr ""

#: ../../source/cli/index.md:139 ffd6a21c0fd7449a860fd9a8986bb109
msgid ""
"`-J, --json / --no-json` : Render output as structured JSON records "
"(equivalent to `--format json`)."
msgstr ""

#: ../../source/cli/index.md:141 b9eac7a316764e0c9ab7a99f0fca76e2
msgid ""
"`-X, --xml / --no-xml` : Render output as a hierarchical XML document "
"(equivalent to `--format xml`)."
msgstr ""

#: ../../source/cli/index.md:144 f3cfb0c8c71c4bbbbe7ba6dd961c93e3
msgid ""
"`-H, --html BASEHREF` : Render output as a semantic HTML5 document with "
"clickable hyperlinks prefixed with `BASEHREF` (equivalent to `--format "
"html`)."
msgstr ""

#: ../../source/cli/index.md:147 45d13d40dc0a4ac380d44db5d5452781
msgid ""
"`--intro PATH` : Prepend custom HTML fragment file before the directory "
"listing in HTML mode."
msgstr ""

#: ../../source/cli/index.md:149 9ef9eca55b45448080e5f3c25d0753de
msgid ""
"`--outro PATH` : Append custom HTML fragment file after the directory "
"listing in HTML mode."
msgstr ""

#: ../../source/cli/index.md:151 c120e95141ba42b697f8d476f64abe3a
msgid ""
"`-T, --title TITLE` : Configure document `<title>` and `<h1>` heading for"
" HTML output (defaults to `Directory Tree`)."
msgstr ""

#: ../../source/cli/index.md:154 e017041d7b724f8c89b34af1ddf0baa9
msgid ""
"`--nolinks / --no-nolinks` : Suppress hyperlink anchors in HTML output, "
"rendering paths as styled plain text."
msgstr ""

#: ../../source/cli/index.md:157 209e227eeed045e8aee25c7e18cf0bc0
msgid ""
"`-o, --output PATH` : Send command output directly to a file rather than "
"standard output. Writes atomically using a temporary file in the "
"destination directory to ensure destination files are never left "
"partially written or corrupted if execution is interrupted."
msgstr ""

#: ../../source/cli/index.md:161 8a8880f38bd843b197b77972621d6eab
msgid ""
"`--table-style STYLE` : Configure table border styles for `table`, `csv-"
"table`, and `rst` formats (`rounded`, `simple`, `minimal`, `double`, "
"`heavy`, `markdown`, `ascii`, `cp437`, `square`, `grid`). Defaults to "
"`rounded`."
msgstr ""

#: ../../source/cli/index.md:165 9867dd4bbd4747d586b99790f0aa24e1
msgid ""
"`--csv-safe / --no-csv-safe` : Neutralize spreadsheet formula injection "
"by prefixing cells beginning with `=`, `+`, `-`, `@`, TAB (`\\t`), or CR "
"(`\\r`) with a single quote (`'`). Useful when exporting file listings to"
" spreadsheet applications where leading characters can trigger dynamic "
"data exchange (DDE) or formula execution."
msgstr ""

#: ../../source/cli/index.md:170 ce91bbc76ada4ed590b92a29bd39a925
msgid ""
"`--pager / --no-pager` : Control interactive terminal paging. Defaults to"
" auto-paging on interactive terminals when output line count exceeds "
"terminal height. Applies to formatted file listings, `--help`, `--help-"
"all`, `--known-tags`, and tall `--diagnostics` outputs. Bypassed "
"automatically when piped or redirected."
msgstr ""

#: ../../source/cli/index.md:175 1663c975c6fd4dc1b0ed88469fe8f141
msgid ""
"`-i, --no-indent / --indent` : Omit branch indentation characters in tree"
" format and strip extraneous whitespace and padding in structured "
"formats."
msgstr ""

#: ../../source/cli/index.md:178 952613e07cf94c7891a765a289497814
msgid ""
"`-A, --ansi-lines / --no-ansi-lines` : Use ANSI/VT100 alternate character"
" set line drawing escapes (`\\033(0...`) for tree indentation lines."
msgstr ""

#: ../../source/cli/index.md:181 f5f45f6910ea43fab456b3df57c7518f
msgid ""
"`-S, --cp437 / --no-cp437` : Use Code Page 437 (IBM-PC) console graphics "
"characters for tree indentation lines."
msgstr ""

#: ../../source/cli/index.md:184 c85584ba4d7c4b0f839ca3c990238f11
msgid ""
"`-C, --color / -n, --no-color` : Force enable or disable ANSI color "
"styling across all output channels unconditionally."
msgstr ""

#: ../../source/cli/index.md:187 a51c42291c9a4959add77a64998de400
msgid ""
"`--absolute, --full-path / --no-absolute, --no-full-path` : Output "
"absolute filesystem paths rather than relative paths."
msgstr ""

#: ../../source/cli/index.md:190 107dd470e9e1424fbfbe1d704aa6622e
msgid ""
"`--relative, --relative-path / --no-relative, --no-relative-path` : "
"Prepend input search path prefix to relative output paths rather than "
"stripping the traversal root."
msgstr ""

#: ../../source/cli/index.md:193 afd7c5bcae7e41cfb6b3c9bd75bbb517
msgid ""
"`-p, --permissions / --no-permissions` : Print file type and permissions "
"in standard `ls -l` format (e.g. `-rw-r--r--`, `drwxr-xr-x`)."
msgstr ""

#: ../../source/cli/index.md:196 5e4f99e370d04f878f86a824711c91cb
msgid ""
"`-u, --user / --no-user` : Print file owner username, falling back to "
"numeric UID if username is unresolvable."
msgstr ""

#: ../../source/cli/index.md:199 55120aa2afe245b18a994cf364fe8fb1
msgid ""
"`-g, --group / --no-group` : Print file owner group name, falling back to"
" numeric GID if group name is unresolvable."
msgstr ""

#: ../../source/cli/index.md:202 e15cd64af2c343ee9a35eec80362c0bb
msgid "`--inodes / --no-inodes` : Print filesystem inode number (`st_ino`)."
msgstr ""

#: ../../source/cli/index.md:204 f9387e4624aa4a5ead6b3bd12b83f570
msgid "`--device / --no-device` : Print filesystem device number (`st_dev`)."
msgstr ""

#: ../../source/cli/index.md:206 cd5b531f282f4e51a7cfa9b745b882cb
msgid "`--size / --no-size` : Print file size in bytes (`st_size`)."
msgstr ""

#: ../../source/cli/index.md:208 5c9306a8cd3c4f4797510f70535e411d
msgid ""
"`-h, --human-readable / --no-human-readable` : Print sizes in human-"
"readable format with IEC/binary unit prefixes (`K`, `M`, `G`, `T`, `P`, "
"`E`) using powers of 1024."
msgstr ""

#: ../../source/cli/index.md:211 a482ce1dfb204b46af0dea2c932c2ce0
msgid ""
"`--si / --no-si` : Print sizes in human-readable format with SI unit "
"prefixes (`kB`, `MB`, `GB`, `TB`, `PB`, `EB`) using powers of 1000."
msgstr ""

#: ../../source/cli/index.md:214 0c35acc2b79842e18546b176326a51bf
msgid ""
"`--du, --accumulate-size / --no-du, --no-accumulate-size` : Recursively "
"calculate and accumulate directory disk usage sizes across all contained "
"files and child directories. In tree format, prints accumulated directory"
" sizes alongside folder nodes. In non-tree formats, lists directories "
"with their total accumulated sizes."
msgstr ""

#: ../../source/cli/index.md:219 4f0dde9718c74d898b150106eeabe147
msgid ""
"`-D, --mtime / --no-mtime` : Print the date and time of the last "
"modification (`st_mtime`)."
msgstr ""

#: ../../source/cli/index.md:221 a3b1c7c7b0334fd08b8bf643286f8dfe
msgid ""
"`--ctime / --no-ctime` : Print the date and time of the last status "
"change (`st_ctime`)."
msgstr ""

#: ../../source/cli/index.md:223 7c6a667c67004fcc93e6ba128dd7c104
msgid ""
"`--time-format, --timefmt FORMAT` : Specify custom date and time output "
"format using `strftime` syntax (implies `-D` unless `--ctime` is "
"explicitly specified)."
msgstr ""

#: ../../source/cli/index.md:226 00da7c21b7d14ea19190bfdc78c964c9
msgid ""
"`-F, --classify / --no-classify` : Append a file classification indicator"
" character to each filename (`*` for executable, `/` for directory, `@` "
"for symbolic link, `=` for socket, `|` for FIFO, `>` for door)."
msgstr ""

#: ../../source/cli/index.md:230 497ffd77806e45d2bfd80280c1b831a8
msgid ""
"`-q, --hide-control-chars / --no-hide-control-chars` : Replace non-"
"printable control characters in filenames with question marks (`?`)."
msgstr ""

#: ../../source/cli/index.md:233 084a72126fa14c828ab81effcb3cfcbd
msgid ""
"`-N, --literal / --no-literal` : Print non-printable control characters "
"literally as raw bytes without masking."
msgstr ""

#: ../../source/cli/index.md:236 a9957ac9b837475cb1d3d4440097a6d0
msgid ""
"`-Q, --quote-name / --no-quote-name` : Enclose filenames in double quotes"
" (`\"...\"`), escaping any embedded double quotes (`\\\"`) and "
"backslashes (`\\\\`)."
msgstr ""

#: ../../source/cli/index.md:239 1fc4c36121434c5b89b3f1f6fe8106e2
msgid ""
"`--hyperlink / --no-hyperlink` : Wrap rendered file and directory paths "
"in standard OSC 8 terminal hyperlink escape sequences "
"(`\\033]8;;URI\\033\\TEXT\\033]8;;\\033\\`), enabling direct click-to-"
"open navigation in modern terminal emulators."
msgstr ""

#: ../../source/cli/index.md:243 b8e91d5ea97e4056981f90a7982b4cde
msgid ""
"`--hyperlink-schema SCHEMA` : Custom URI schema prefix for terminal "
"hyperlinks (defaults to `file://`). Supports standard local file schemes "
"as well as editor URI schemas such as `vscode://file/`, `cursor://file/`,"
" or `subl://`."
msgstr ""

#: ../../source/cli/index.md:247 58a2b504e9ed4853b8311f6e2ab663a9
msgid ""
"`--hyperlink-authority AUTHORITY` : Optional authority or hostname "
"component for terminal hyperlinks (e.g., `localhost` or remote "
"workstation hostnames)."
msgstr ""

#: ../../source/cli/index.md:250 a9674ef0efaa46c787fc8c0307f58897
msgid ""
"`-0, --print0 / --no-print0` : Delimit paths with a NUL (`\\0`) byte "
"instead of a newline for safe consumption by `xargs -0`."
msgstr ""

#: ../../source/cli/index.md:253 d800e6574572474a83086dbeef1ebcd5
msgid ""
"`--list-tags / --no-list-tags` : Print identified format and content tags"
" alongside each matched path."
msgstr ""

#: ../../source/cli/index.md:256 0b8eb8763bcc4788ad1fbfd72f4250d9
msgid ""
"`-s, --summary / --no-summary` : Print summary match statistics and top "
"format tags to `stderr`."
msgstr ""

#: ../../source/cli/index.md:258 95e90692a7824629ba33be5ec29e7e93
msgid ""
"`--exit-status / --no-exit-status` : Exit with status code 1 if no "
"matching files are found (returns code 0 when one or more matches are "
"found)."
msgstr ""

#: ../../source/cli/index.md:261 f648513c015e4bc781037160e158eb4a
msgid "3.4. Information & Diagnostics"
msgstr ""

#: ../../source/cli/index.md:263 e0fbed3e2ca7471d83d4605f18478116
msgid ""
"`--config PATH` : Path to a custom user configuration file overriding "
"default settings."
msgstr ""

#: ../../source/cli/index.md:265 47c3712acedb418eb099e0c1445595ee
msgid ""
"`--no-config` : Suppress discovery and loading of any configuration file,"
" enforcing built-in factory defaults."
msgstr ""

#: ../../source/cli/index.md:268 de40fad5be9042b6bee39a312d886473
msgid ""
"`--show-config` : Display the active configuration file and resolved "
"configuration settings, then exit immediately."
msgstr ""

#: ../../source/cli/index.md:271 e044a8ec8abb49ccb22d56e20d85f226
msgid ""
"`--known-tags` : List all tags supported by the classifier engine and "
"exit immediately (routed through the interactive pager on TTY sessions "
"exceeding terminal height)."
msgstr ""

#: ../../source/cli/index.md:274 3db0c75bb73348d0b9a077cd3969f0dc
msgid ""
"`--locale, --lang LOCALE` : Set display language and locale for console "
"messages, help descriptions, and diagnostic outputs (e.g. `en_US`, `es`, "
"`fr`, `de`, `ja`, or `C` for raw untranslated strings)."
msgstr ""

#: ../../source/cli/index.md:277 f9c9f930297447218d17c40d909faa95
msgid ""
"`-v, -V, --version` : Display the version of `findfmt` and exit. When "
"combined with `--verbose`, prints runtime environment diagnostics (Python"
" runtime, OS platform, identify engine, and Git) via the interactive "
"pager when exceeding terminal height."
msgstr ""

#: ../../source/cli/index.md:281 dd923d0f4ff247f0842eba262d0574fb
msgid ""
"`--verbose` : Enable verbose diagnostic output when paired with "
"`--version`."
msgstr ""

#: ../../source/cli/index.md:283 60ca89ea15a4494698cf1a03026879e2
msgid ""
"`--diagnostics` : Display runtime environment diagnostics and exit "
"immediately (routed through the interactive pager on TTY sessions "
"exceeding terminal height)."
msgstr ""

#: ../../source/cli/index.md:286 d21d1885bfc64be79c632bc157dd2c71
msgid ""
"`--help-all` : Display the comprehensive CLI manual, environment "
"variables, and exit codes (routed through the interactive pager on TTY "
"sessions exceeding terminal height)."
msgstr ""

#: ../../source/cli/index.md:289 d95dba09d439487fb6f0d2ea17a09798
msgid ""
"`--help` : Show the categorized help message and exit (automatically "
"routed through the interactive pager on TTY sessions exceeding terminal "
"height)."
msgstr ""

#: ../../source/cli/index.md:292 f782bf90a5874c88a831ee625ae8dfb8
msgid "4. Command Wrappers & Aliases"
msgstr ""

#: ../../source/cli/index.md:294 60f9f599e5b7432d99f236765749e372
msgid ""
"In addition to `findfmt`, several specialized command-line entry points "
"are provided to streamline common workflows:"
msgstr ""

#: ../../source/cli/index.md:297 1009315b90fb424598271b0bcb6036bd
msgid ""
"**`findfiles [PATHS...]`** : Traverse all files and directories including"
" hidden files (`.*`), respecting `.gitignore` (equivalent to `findfmt "
"--hidden`). Negate with `--no-hidden`."
msgstr ""

#: ../../source/cli/index.md:299 31a93ee8e32e48ee87c55095c2cee4d6
msgid ""
"**`findfilemime [PATHS...]`** : List matched paths alongside their "
"detected MIME and format tags, including hidden files (equivalent to "
"`findfmt --hidden --list-tags`). Negate with `--no-list-tags`."
msgstr ""

#: ../../source/cli/index.md:302 208108d51a8946a4bed3f9a9e294d941
msgid ""
"**`findfilefmt [TAG] [PATHS...]`** : Locate files matching a format tag "
"(e.g. `findfilefmt python`), including hidden files (equivalent to "
"`findfmt --hidden --tag [TAG]`)."
msgstr ""

#: ../../source/cli/index.md:304 fe4ef66a89ff47e38753a31ac309199b
msgid ""
"**`findshebang [INTERPRETER] [PATHS...]`** : Discover scripts by shebang "
"interpreter pattern (e.g. `findshebang bash`), including hidden files "
"(equivalent to `findfmt --hidden --shebang [INTERPRETER]`)."
msgstr ""

#: ../../source/cli/index.md:307 575df47b283449c0b193ede4c7f9d1ba
msgid ""
"**`findfmt0 [PATHS...]`** : Produce NUL-delimited output for pipe-safe "
"consumption with `xargs -0`, including hidden files (equivalent to "
"`findfmt --hidden --print0`). Negate with `--no-print0`."
msgstr ""

#: ../../source/cli/index.md:310 c230de517dfa43f886a0406a4644042d
msgid ""
"**`findsummary [PATHS...]`** : Print format tag frequency statistics "
"directly to `stderr`, including hidden files (equivalent to `findfmt "
"--hidden --summary`). Negate with `--no-summary`."
msgstr ""

#: ../../source/cli/index.md:313 df13cd1d01f04505b2766528cbe04a03
msgid "5. POSIX Option Terminator (--)"
msgstr ""

#: ../../source/cli/index.md:315 62e85d512295425ab64fcb04722be88c
msgid ""
"A standalone double-dash (`--`) halts option processing per POSIX "
"Guideline 10. All subsequent tokens are treated strictly as positional "
"filesystem paths, even if their names begin with a hyphen:"
msgstr ""

#: ../../source/cli/index.md:323 85a966761ecc41a990c486e7d92b56b9
msgid "6. Environment"
msgstr ""

#: ../../source/cli/index.md:325 0bb4aac945ab43b99972c1ff84fd2bc6
msgid ""
"`NO_COLOR`: When set to any value, colored output is suppressed per [no-"
"color.org](https://no-color.org)."
msgstr ""

#: ../../source/cli/index.md:327 f36d3a76dd7d4111981d816a54a2d354
msgid ""
"`CLICOLOR`: When set to `0`, ANSI color codes are disabled; when `1`, "
"colors are enabled."
msgstr ""

#: ../../source/cli/index.md:328 93b609bbca384d8985f8078eac9c6ac7
msgid ""
"`CLICOLOR_FORCE`: When non-zero, forces color output even when redirected"
" or piped."
msgstr ""

#: ../../source/cli/index.md:329 3a54484108d04edc8819e1b2560603b1
msgid ""
"`LANGUAGE`: POSIX language lookup order (colon-separated list of locale "
"codes, e.g. `es_ES:es:en`)."
msgstr ""

#: ../../source/cli/index.md:331 47b5241870244ced9f604408f00ce506
msgid ""
"`LC_ALL`: Highest-precedence locale override overriding all other `LC_*` "
"variables."
msgstr ""

#: ../../source/cli/index.md:332 8fe01012555e42ac9d565ded6666d4ff
msgid ""
"`LC_MESSAGES`: Localization category determining message translation "
"catalog selection."
msgstr ""

#: ../../source/cli/index.md:333 5da44a83ee404d02a32f9930b75cc1a6
msgid "`LANG`: Default system fallback locale identifier."
msgstr ""

#: ../../source/cli/index.md:334 91d6bc7646d542468f3db96fddf788fa
msgid ""
"`FINDFMT_CONFIG`: Path to a custom user configuration file overriding "
"defaults. When unset, `findfmt` checks "
"`$XDG_CONFIG_HOME/findfmt/config.toml` (or "
"`~/.config/findfmt/config.toml`), followed by `pyproject.toml` "
"(`[tool.findfmt]` table) in the working directory. Refer to the "
"[Configuration Guide](../guides/configuration.md) for full schema "
"details."
msgstr ""

#: ../../source/cli/index.md:338 95fef361ebcf4e129c7031281d99cd2b
msgid ""
"`XDG_CONFIG_HOME`: Configuration directory root used to resolve "
"`$XDG_CONFIG_HOME/findfmt/config.toml` and `$XDG_CONFIG_HOME/git/ignore`."
msgstr ""

#: ../../source/cli/index.md:340 e90ef26bf3b442928a907d7ad8d271c5
msgid ""
"`PATHEXT`: Semicolon-delimited list of executable file extensions on "
"Windows."
msgstr ""

#: ../../source/cli/index.md:342 4a418e11189448eea89884d298256e39
msgid "7. Exit Status"
msgstr ""

#: ../../source/cli/index.md:8 26e046f0bec54c04b36f554873fe7b5d
msgid "Code"
msgstr ""

#: ../../source/cli/index.md:8 4928e660cd824f00aa2ce062272ef26b
msgid "Meaning"
msgstr ""

#: ../../source/cli/index.md:8 075b4bc475ee405a80bd05bcffe061f2
msgid "`0`"
msgstr ""

#: ../../source/cli/index.md:8 020bf63e02f7437b90ca29fedcc38ed5
msgid ""
"Success, including runs where no files match, help/version/diagnostics "
"queries, and early pipeline termination (`SIGPIPE`)."
msgstr ""

#: ../../source/cli/index.md:8 023c587f17d14f229833bb6a107b3153
msgid "`1`"
msgstr ""

#: ../../source/cli/index.md:8 46e62c2b2f714f0498194d527807ef1f
msgid ""
"Runtime traversal, classification, or filesystem I/O error, or no "
"matching files when `--exit-status` is given."
msgstr ""

#: ../../source/cli/index.md:8 43bacc28940046d29426a8862687d42b
msgid "`2`"
msgstr ""

#: ../../source/cli/index.md:8 2911e2d5e2d94461b7425ac7895fb39a
msgid ""
"Invalid command-line arguments, conflicting options, or configuration "
"file error."
msgstr ""

#: ../../source/cli/index.md:8 22eaf7434ed84cf388117ecb33f6b164
msgid "`130`"
msgstr ""

#: ../../source/cli/index.md:8 3c8cf271c8fc4c769399ca4af00e3445
msgid "Execution interrupted by `SIGINT` (`Ctrl+C`)."
msgstr ""

#: ../../source/cli/index.md:351 dde1385421f943f9bc2a3bc74074060a
msgid ""
"Pass `--exit-status` for `grep`-style scripting, where \"nothing "
"matched\" should be a failure. The command wrappers (`findfiles`, "
"`findfilefmt`, `findfilemime`, `findfmt0`, `findshebang`, `findsummary`) "
"follow the same exit-code contract across all status codes (`0`, `1`, "
"`2`, and `130`)."
msgstr ""

