msgid "Verdict"
msgstr ""

#: ../../source/quality/sidebar_navigation.md 2e3390b6fcc44aa29320b7e5672645e1
msgid "**Option A: `:maxdepth:` Directive Audit Only**"
msgstr ""

#: ../../source/quality/sidebar_navigation.md 9f3bf7127f944319955f840eb70349ee
msgid ""
"Increase `:maxdepth:` in `index.md`, `guides/index.md`, `api/index.md`, "
"and `quality/index.md`."
msgstr ""

#: ../../source/quality/sidebar_navigation.md a9ed00b357904c57b993b949b95d0b84
msgid ""
"No change; Furo's hardcoded `titles_only=True` suppresses all in-page "
"headings."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 9a072fc7d00c4a66b0f4aef7a648816f
msgid "None, but fails to meet functional requirements."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 0019cb41acd643ea93aa7c23ba376344
#: 2e0b9bc712a640e5bf01fd1e8896a1de 48910548570349a494c3069fdc0daa01
msgid "**Rejected**"
msgstr ""

#: ../../source/quality/sidebar_navigation.md 1471a423b5ff4274946953f6889428d5
msgid "**Option B: Client-Side DOM Mirroring (Custom JS)**"
msgstr ""

#: ../../source/quality/sidebar_navigation.md b884db1dd6d64a8dac290cd35326c4ad
msgid ""
"Inject custom JavaScript to clone `.toc-tree` headings into `.sidebar-"
"tree` after page load."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 7995ca3f561d440590d2b13b3d98eaad
msgid ""
"Only populates headings for the currently loaded page; causes layout "
"shift without JavaScript."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 4bae441f5be94dc3a26a0decdb9adc15
msgid "High; fragile across Furo DOM updates."
msgstr ""

#: ../../source/quality/sidebar_navigation.md dfd044f20d944e0aa32cfc47b950c2e8
msgid "**Option C: Document Splitting into Micro-Pages**"
msgstr ""

#: ../../source/quality/sidebar_navigation.md 8f2d9e565dee4760927ca1359f761d20
msgid ""
"Split every `H2`/`H3` section in `cli/index.md` and `api/findfmt.md` into"
" separate `.md` files."
msgstr ""

#: ../../source/quality/sidebar_navigation.md f95afe17ed4843d1ad6bd661cbe6325f
msgid ""
"Works with `titles_only=True`, but fragments single-page reading, man-"
"page builds, and i18n."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 38cbfd1b44e848a9a302b4de6009630f
msgid "High; multiplies `.po` translation catalogs and cross-links."
msgstr ""

#: ../../source/quality/sidebar_navigation.md e0e99f6fcc9a42d89f76ce8e305cf45f
msgid "**Option D: Sphinx `html-page-context` Hook + Template/CSS Polish**"
msgstr ""

#: ../../source/quality/sidebar_navigation.md 743d64373f5c43a6ba4317f3f8e6b49f
msgid ""
"Rebuild `furo_navigation_tree` with `titles_only=False` and `maxdepth=4` "
"via `get_navigation_tree` at `priority=600`."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 66ba11f6062d47599ed3cf55c55ca4dc
msgid ""
"Preserves native CSS-only checkboxes, mobile drawer behavior, and "
"`role=\"switch\"` semantics."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 3f34e628601e448faa9836e9eac3df4e
msgid "Low; uses public Sphinx events and standard Furo transformers."
msgstr ""

#: ../../source/quality/sidebar_navigation.md 0d760d41bf434fb18c213d28d9eae420
msgid "**Selected**"
msgstr ""

#: ../../source/quality/sidebar_navigation.md:79
#: f7ccb0b2e3b543a59a10011bb07ab014
msgid "3. Architecture Decision & Implementation Details"
msgstr ""

#: ../../source/quality/sidebar_navigation.md:81
